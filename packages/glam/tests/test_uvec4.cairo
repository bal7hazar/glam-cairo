#[test]
fn test_assign_ops() {
    let mut a = uvec4(20, 40, 80, 160);
    a += uvec4(2, 3, 7, 9);
    assert_eq!(a, uvec4(22, 43, 87, 169));
    let mut a = uvec4(20, 40, 80, 160);
    a += 3;
    assert_eq!(a, uvec4(23, 43, 83, 163));
    let mut a = uvec4(20, 40, 80, 160);
    a -= uvec4(2, 3, 7, 9);
    assert_eq!(a, uvec4(18, 37, 73, 151));
    let mut a = uvec4(20, 40, 80, 160);
    a -= 3;
    assert_eq!(a, uvec4(17, 37, 77, 157));
    let mut a = uvec4(20, 40, 80, 160);
    a *= uvec4(2, 3, 7, 9);
    assert_eq!(a, uvec4(40, 120, 560, 1440));
    let mut a = uvec4(20, 40, 80, 160);
    a *= 3;
    assert_eq!(a, uvec4(60, 120, 240, 480));
    let mut a = uvec4(20, 40, 80, 160);
    a /= uvec4(2, 3, 7, 9);
    assert_eq!(a, uvec4(10, 13, 11, 17));
    let mut a = uvec4(20, 40, 80, 160);
    a /= 3;
    assert_eq!(a, uvec4(6, 13, 26, 53));
    let mut a = uvec4(20, 40, 80, 160);
    a %= uvec4(2, 3, 7, 9);
    assert_eq!(a, uvec4(0, 1, 3, 7));
    let mut a = uvec4(20, 40, 80, 160);
    a %= 3;
    assert_eq!(a, uvec4(2, 1, 2, 1));
}

