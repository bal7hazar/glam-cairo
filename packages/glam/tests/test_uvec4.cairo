#[test]
fn test_wrapping_saturating() {
    assert_eq!(uvec4(4294967295, 0, 5, 4).wrapping_add(uvec4(1, 2, 3, 2)), uvec4(0, 2, 8, 6));
    assert_eq!(uvec4(0, 4, 5, 4).wrapping_sub(uvec4(1, 2, 3, 2)), uvec4(4294967295, 2, 2, 2));
    assert_eq!(
        uvec4(4294967295, 2, 5, 4).wrapping_mul(uvec4(3, 2, 3, 2)), uvec4(4294967293, 4, 15, 8),
    );
    assert_eq!(
        uvec4(4294967295, 2, 5, 4).wrapping_div(uvec4(3, 2, 3, 2)), uvec4(1431655765, 1, 1, 2),
    );
    assert_eq!(
        uvec4(4294967295, 4294967295, 0, 0).saturating_add(uvec4(1, 4294967295, 2, 3)),
        uvec4(4294967295, 4294967295, 2, 3),
    );
    assert_eq!(
        uvec4(0, 4294967295, 0, 0).saturating_sub(uvec4(1, 1, 2, 3)), uvec4(0, 4294967294, 0, 0),
    );
    assert_eq!(
        uvec4(4294967295, 4294967295, 0, 0).saturating_mul(uvec4(2, 4294967295, 3, 4)),
        uvec4(4294967295, 4294967295, 0, 0),
    );
    assert_eq!(
        uvec4(4294967295, 4294967295, 0, 0).saturating_div(uvec4(2, 4294967295, 3, 4)),
        uvec4(2147483647, 1, 0, 0),
    );
}

#[test]
fn test_signed_ops() {
    assert_eq!(UVec4Trait::MAX.checked_add_signed(IVec4Trait::ONE), None);
    assert_eq!(UVec4Trait::ONE.checked_add_signed(IVec4Trait::NEG_ONE), Some(UVec4Trait::ZERO));
    assert_eq!(UVec4Trait::ZERO.checked_add_signed(IVec4Trait::NEG_ONE), None);
    assert_eq!(UVec4Trait::MAX.wrapping_add_signed(IVec4Trait::ONE), UVec4Trait::MIN);
    assert_eq!(UVec4Trait::MIN.wrapping_add_signed(IVec4Trait::NEG_ONE), UVec4Trait::MAX);
    assert_eq!(UVec4Trait::MAX.saturating_add_signed(IVec4Trait::ONE), UVec4Trait::MAX);
    assert_eq!(UVec4Trait::MIN.saturating_add_signed(IVec4Trait::NEG_ONE), UVec4Trait::MIN);
    assert_eq!(
        uvec4(0, 1, 2, 7).checked_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)), None,
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).wrapping_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)),
        uvec4(2147483648, 2147483650, 4294901762, 4294920962),
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).saturating_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)),
        uvec4(0, 0, 0, 0),
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).checked_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)), None,
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).wrapping_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)),
        uvec4(2147483648, 2147483650, 4294901762, 4294920962),
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).saturating_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)),
        uvec4(0, 0, 0, 0),
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).checked_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)), None,
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).wrapping_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)),
        uvec4(2147483648, 2147483650, 4294901762, 4294920962),
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).saturating_add_signed(ivec4(-2147483648, -2147483647, -65536, -46341)),
        uvec4(0, 0, 0, 0),
    );
    assert_eq!(
        uvec4(1, 2, 7, 65535).checked_add_signed(ivec4(-2147483647, -65536, -46341, -7)), None,
