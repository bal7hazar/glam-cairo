#[test]
fn test_clamp() {
    assert_eq!(uvec4(0, 0, 0, 0).clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(1, 3, 3, 2));
    assert_eq!(uvec4(2, 2, 2, 2).clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(2, 3, 3, 2));
    assert_eq!(uvec4(4, 4, 4, 4).clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(4, 4, 4, 4));
    assert_eq!(uvec4(5, 5, 5, 5).clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(5, 5, 5, 5));
    assert_eq!(uvec4(6, 6, 6, 6).clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(6, 6, 6, 6));
    assert_eq!(uvec4(7, 7, 7, 7).clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(6, 7, 7, 7));
    assert_eq!(uvec4(9, 9, 9, 9).clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(6, 8, 8, 9));
    assert_eq!(UVec4Trait::MIN.clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(1, 3, 3, 2));
    assert_eq!(UVec4Trait::MAX.clamp(uvec4(1, 3, 3, 2), uvec4(6, 8, 8, 9)), uvec4(6, 8, 8, 9));
    assert_eq!(uvec4(1, 3, 3, 2).clamp(UVec4Trait::MIN, UVec4Trait::MAX), uvec4(1, 3, 3, 2));
}

#[test]
fn test_sum_product() {
    assert_eq!(uvec4(1, 2, 3, 4).element_sum(), 10);
    assert_eq!(uvec4(1, 2, 3, 4).element_product(), 24);
    assert_eq!(uvec4(30, 7, 110, 13).element_sum(), 160);
    assert_eq!(uvec4(30, 7, 110, 13).element_product(), 300300);
    assert_eq!(uvec4(1, 2, 3, 4).element_sum(), 10);
    assert_eq!(uvec4(1, 2, 3, 4).element_product(), 24);
    assert_eq!(uvec4(0, 1, 5, 2).element_sum(), 8);
    assert_eq!(uvec4(0, 1, 5, 2).element_product(), 0);
    assert_eq!(uvec4(100, 200, 300, 400).element_sum(), 1000);
    assert_eq!(uvec4(100, 200, 300, 400).element_product(), 2400000000);
}

