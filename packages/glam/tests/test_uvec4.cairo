#[test]
fn test_manhattan_chebyshev_distance() {
    assert_eq!(uvec4(3, 27, 98, 5).manhattan_distance(uvec4(20, 65, 97, 9)), 60);
    assert_eq!(uvec4(3, 27, 98, 5).chebyshev_distance(uvec4(20, 65, 97, 9)), 38);
    assert_eq!(UVec4Trait::MIN.checked_manhattan_distance(UVec4Trait::MAX), None);
    assert_eq!(UVec4Trait::MIN.chebyshev_distance(UVec4Trait::MAX), 4294967295);
    assert_eq!(UVec4Trait::MAX.chebyshev_distance(UVec4Trait::MIN), 4294967295);
    assert_eq!(UVec4Trait::MIN.manhattan_distance(UVec4Trait::MIN.with_x(4294967295)), 4294967295);
    assert_eq!(
        uvec4(0, 1, 2, 7).checked_manhattan_distance(uvec4(1, 7, 65536, 2147483648)),
        Some(2147549182),
    );
    assert_eq!(uvec4(0, 1, 2, 7).manhattan_distance(uvec4(1, 7, 65536, 2147483648)), 2147549182);
    assert_eq!(uvec4(0, 1, 2, 7).chebyshev_distance(uvec4(1, 7, 65536, 2147483648)), 2147483641);
    assert_eq!(
        uvec4(0, 1, 2, 7).checked_manhattan_distance(uvec4(7, 65536, 2147483648, 4294967294)), None,
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).chebyshev_distance(uvec4(7, 65536, 2147483648, 4294967294)), 4294967287,
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).checked_manhattan_distance(uvec4(65536, 2147483648, 4294967294, 0)), None,
    );
    assert_eq!(
        uvec4(0, 1, 2, 7).chebyshev_distance(uvec4(65536, 2147483648, 4294967294, 0)), 4294967292,
    );
    assert_eq!(
        uvec4(1, 2, 7, 65535).checked_manhattan_distance(uvec4(2, 65535, 2147483647, 2147483649)),
        Some(4294967288),
    );
    assert_eq!(
        uvec4(1, 2, 7, 65535).manhattan_distance(uvec4(2, 65535, 2147483647, 2147483649)),
        4294967288,
    );
    assert_eq!(
        uvec4(1, 2, 7, 65535).chebyshev_distance(uvec4(2, 65535, 2147483647, 2147483649)),
        2147483640,
    );
    assert_eq!(
        uvec4(1, 2, 7, 65535)
            .checked_manhattan_distance(uvec4(2147483647, 2147483649, 4294967295, 1)),
        None,
    );
    assert_eq!(
        uvec4(1, 2, 7, 65535).chebyshev_distance(uvec4(2147483647, 2147483649, 4294967295, 1)),
        4294967288,
    );
    assert_eq!(
        uvec4(1, 2, 7, 65535).checked_manhattan_distance(uvec4(4294967295, 1, 7, 65536)), None,
    );
    assert_eq!(
        uvec4(1, 2, 7, 65535).chebyshev_distance(uvec4(4294967295, 1, 7, 65536)), 4294967294,
    );
    assert_eq!(
        uvec4(2, 7, 65535, 65536)
            .checked_manhattan_distance(uvec4(7, 65536, 2147483648, 4294967294)),
        None,
    );
    assert_eq!(
        uvec4(2, 7, 65535, 65536).chebyshev_distance(uvec4(7, 65536, 2147483648, 4294967294)),
        4294901758,
    );
    assert_eq!(
        uvec4(2, 7, 65535, 65536).checked_manhattan_distance(uvec4(4294967294, 0, 2, 65535)), None,
    );
    assert_eq!(
        uvec4(2, 7, 65535, 65536).chebyshev_distance(uvec4(4294967294, 0, 2, 65535)), 4294967292,
