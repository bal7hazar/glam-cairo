    assert_eq!(
        uvec4(2147483649, 4294967294, 4294967295, 0).shl(31), uvec4(2147483648, 0, 2147483648, 0),
    );
    assert_eq!(uvec4(2147483649, 4294967294, 4294967295, 0).shr(31), uvec4(1, 1, 1, 0));
    assert_eq!(uvec4(4294967294, 4294967295, 0, 1).shl(31), uvec4(0, 2147483648, 0, 2147483648));
    assert_eq!(uvec4(4294967294, 4294967295, 0, 1).shr(31), uvec4(1, 1, 0, 0));
    assert_eq!(uvec4(4294967295, 0, 1, 2).shl(31), uvec4(2147483648, 0, 2147483648, 0));
    assert_eq!(uvec4(4294967295, 0, 1, 2).shr(31), uvec4(1, 0, 0, 0));
}

#[test]
fn test_hash_serde() {
    let a = uvec4(1, 2, 3, 4);
    let b = uvec4(4, 3, 2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 4);
    let mut span = out.span();
    assert_eq!(Serde::<UVec4>::deserialize(ref span), Some(a));
}

