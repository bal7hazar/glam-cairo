    assert_eq!(uvec4(0, 1, 5, 2).dot_into_vec(uvec4(7, 9, 7, 3)), uvec4(50, 50, 50, 50));
    assert_eq!(uvec4(0, 1, 5, 2).length_squared(), 30);
    assert_eq!(uvec4(100, 200, 300, 400).dot(uvec4(9, 8, 7, 6)), 7000);
    assert_eq!(
        uvec4(100, 200, 300, 400).dot_into_vec(uvec4(9, 8, 7, 6)), uvec4(7000, 7000, 7000, 7000),
    );
    assert_eq!(uvec4(100, 200, 300, 400).length_squared(), 300000);
    assert_eq!(uvec4(65535, 3, 1, 0).dot(uvec4(65535, 5, 1, 5)), 4294836241);
    assert_eq!(
        uvec4(65535, 3, 1, 0).dot_into_vec(uvec4(65535, 5, 1, 5)),
        uvec4(4294836241, 4294836241, 4294836241, 4294836241),
    );
