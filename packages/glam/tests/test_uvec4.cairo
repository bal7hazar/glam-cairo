    assert_eq!(uvec4(30, 7, 110, 13).length_squared(), 13218);
    assert_eq!(uvec4(1, 2, 3, 4).dot(uvec4(4, 3, 2, 1)), 20);
    assert_eq!(uvec4(1, 2, 3, 4).dot_into_vec(uvec4(4, 3, 2, 1)), uvec4(20, 20, 20, 20));
