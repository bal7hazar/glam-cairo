fn test_wrapping_saturating() {
    assert_eq!(uvec2(4294967295, 5).wrapping_add(uvec2(1, 3)), uvec2(0, 8));
    assert_eq!(uvec2(0, 5).wrapping_sub(uvec2(1, 3)), uvec2(4294967295, 2));
    assert_eq!(uvec2(4294967295, 2).wrapping_mul(uvec2(3, 2)), uvec2(4294967293, 4));
    assert_eq!(uvec2(4294967295, 2).wrapping_div(uvec2(3, 2)), uvec2(1431655765, 1));
    assert_eq!(
        uvec2(4294967295, 4294967295).saturating_add(uvec2(1, 4294967295)),
        uvec2(4294967295, 4294967295),
    );
    assert_eq!(uvec2(0, 4294967295).saturating_sub(uvec2(1, 1)), uvec2(0, 4294967294));
    assert_eq!(
        uvec2(4294967295, 4294967295).saturating_mul(uvec2(2, 4294967295)),
        uvec2(4294967295, 4294967295),
    );
    assert_eq!(
        uvec2(4294967295, 4294967295).saturating_div(uvec2(2, 4294967295)), uvec2(2147483647, 1),
    );
}

