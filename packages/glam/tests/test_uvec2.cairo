    assert_eq!(uvec2(2147483648, 2147483649).shr(30), uvec2(2, 2));
    assert_eq!(uvec2(2147483649, 4294967294).shl(30), uvec2(1073741824, 2147483648));
    assert_eq!(uvec2(2147483649, 4294967294).shr(30), uvec2(2, 3));
    assert_eq!(uvec2(4294967294, 4294967295).shl(30), uvec2(2147483648, 3221225472));
    assert_eq!(uvec2(4294967294, 4294967295).shr(30), uvec2(3, 3));
    assert_eq!(uvec2(4294967295, 0).shl(30), uvec2(3221225472, 0));
    assert_eq!(uvec2(4294967295, 0).shr(30), uvec2(3, 0));
    assert_eq!(uvec2(0, 1).shl(31), uvec2(0, 2147483648));
    assert_eq!(uvec2(0, 1).shr(31), uvec2(0, 0));
    assert_eq!(uvec2(1, 2).shl(31), uvec2(2147483648, 0));
    assert_eq!(uvec2(1, 2).shr(31), uvec2(0, 0));
    assert_eq!(uvec2(2, 7).shl(31), uvec2(0, 2147483648));
    assert_eq!(uvec2(2, 7).shr(31), uvec2(0, 0));
    assert_eq!(uvec2(7, 65535).shl(31), uvec2(2147483648, 2147483648));
    assert_eq!(uvec2(7, 65535).shr(31), uvec2(0, 0));
    assert_eq!(uvec2(65535, 65536).shl(31), uvec2(2147483648, 0));
    assert_eq!(uvec2(65535, 65536).shr(31), uvec2(0, 0));
    assert_eq!(uvec2(65536, 2147483647).shl(31), uvec2(0, 2147483648));
    assert_eq!(uvec2(65536, 2147483647).shr(31), uvec2(0, 0));
    assert_eq!(uvec2(2147483647, 2147483648).shl(31), uvec2(2147483648, 0));
    assert_eq!(uvec2(2147483647, 2147483648).shr(31), uvec2(0, 1));
    assert_eq!(uvec2(2147483648, 2147483649).shl(31), uvec2(0, 2147483648));
    assert_eq!(uvec2(2147483648, 2147483649).shr(31), uvec2(1, 1));
    assert_eq!(uvec2(2147483649, 4294967294).shl(31), uvec2(2147483648, 0));
    assert_eq!(uvec2(2147483649, 4294967294).shr(31), uvec2(1, 1));
    assert_eq!(uvec2(4294967294, 4294967295).shl(31), uvec2(0, 2147483648));
    assert_eq!(uvec2(4294967294, 4294967295).shr(31), uvec2(1, 1));
    assert_eq!(uvec2(4294967295, 0).shl(31), uvec2(2147483648, 0));
    assert_eq!(uvec2(4294967295, 0).shr(31), uvec2(1, 0));
}

#[test]
fn test_hash_serde() {
    let a = uvec2(1, 2);
    let b = uvec2(2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 2);
    let mut span = out.span();
    assert_eq!(Serde::<UVec2>::deserialize(ref span), Some(a));
}

