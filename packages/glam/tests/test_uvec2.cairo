#[test]
fn test_assign_ops() {
    let mut a = uvec2(20, 40);
    a += uvec2(2, 3);
    assert_eq!(a, uvec2(22, 43));
    let mut a = uvec2(20, 40);
    a += 3;
    assert_eq!(a, uvec2(23, 43));
    let mut a = uvec2(20, 40);
    a -= uvec2(2, 3);
    assert_eq!(a, uvec2(18, 37));
    let mut a = uvec2(20, 40);
    a -= 3;
    assert_eq!(a, uvec2(17, 37));
    let mut a = uvec2(20, 40);
    a *= uvec2(2, 3);
    assert_eq!(a, uvec2(40, 120));
    let mut a = uvec2(20, 40);
    a *= 3;
    assert_eq!(a, uvec2(60, 120));
    let mut a = uvec2(20, 40);
    a /= uvec2(2, 3);
    assert_eq!(a, uvec2(10, 13));
    let mut a = uvec2(20, 40);
    a /= 3;
    assert_eq!(a, uvec2(6, 13));
    let mut a = uvec2(20, 40);
    a %= uvec2(2, 3);
    assert_eq!(a, uvec2(0, 1));
    let mut a = uvec2(20, 40);
    a %= 3;
    assert_eq!(a, uvec2(2, 1));
}

