#[test]
fn test_clamp() {
    assert_eq!(uvec2(0, 0).clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(1, 3));
    assert_eq!(uvec2(2, 2).clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(2, 3));
    assert_eq!(uvec2(4, 4).clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(4, 4));
    assert_eq!(uvec2(5, 5).clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(5, 5));
    assert_eq!(uvec2(6, 6).clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(6, 6));
    assert_eq!(uvec2(7, 7).clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(6, 7));
    assert_eq!(uvec2(9, 9).clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(6, 8));
    assert_eq!(UVec2Trait::MIN.clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(1, 3));
    assert_eq!(UVec2Trait::MAX.clamp(uvec2(1, 3), uvec2(6, 8)), uvec2(6, 8));
    assert_eq!(uvec2(1, 3).clamp(UVec2Trait::MIN, UVec2Trait::MAX), uvec2(1, 3));
}

#[test]
fn test_sum_product() {
    assert_eq!(uvec2(1, 2).element_sum(), 3);
    assert_eq!(uvec2(1, 2).element_product(), 2);
    assert_eq!(uvec2(30, 7).element_sum(), 37);
    assert_eq!(uvec2(30, 7).element_product(), 210);
    assert_eq!(uvec2(1, 2).element_sum(), 3);
    assert_eq!(uvec2(1, 2).element_product(), 2);
    assert_eq!(uvec2(0, 1).element_sum(), 1);
    assert_eq!(uvec2(0, 1).element_product(), 0);
    assert_eq!(uvec2(100, 200).element_sum(), 300);
    assert_eq!(uvec2(100, 200).element_product(), 20000);
}

