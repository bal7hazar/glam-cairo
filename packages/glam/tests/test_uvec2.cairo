#[test]
fn test_manhattan_chebyshev_distance() {
    assert_eq!(uvec2(3, 27).manhattan_distance(uvec2(20, 65)), 55);
    assert_eq!(uvec2(3, 27).chebyshev_distance(uvec2(20, 65)), 38);
    assert_eq!(UVec2Trait::MIN.checked_manhattan_distance(UVec2Trait::MAX), None);
    assert_eq!(UVec2Trait::MIN.chebyshev_distance(UVec2Trait::MAX), 4294967295);
    assert_eq!(UVec2Trait::MAX.chebyshev_distance(UVec2Trait::MIN), 4294967295);
    assert_eq!(UVec2Trait::MIN.manhattan_distance(UVec2Trait::MIN.with_x(4294967295)), 4294967295);
    assert_eq!(uvec2(0, 1).checked_manhattan_distance(uvec2(1, 7)), Some(7));
    assert_eq!(uvec2(0, 1).manhattan_distance(uvec2(1, 7)), 7);
    assert_eq!(uvec2(0, 1).chebyshev_distance(uvec2(1, 7)), 6);
    assert_eq!(uvec2(0, 1).checked_manhattan_distance(uvec2(7, 65536)), Some(65542));
    assert_eq!(uvec2(0, 1).manhattan_distance(uvec2(7, 65536)), 65542);
    assert_eq!(uvec2(0, 1).chebyshev_distance(uvec2(7, 65536)), 65535);
    assert_eq!(uvec2(0, 1).checked_manhattan_distance(uvec2(65536, 2147483648)), Some(2147549183));
    assert_eq!(uvec2(0, 1).manhattan_distance(uvec2(65536, 2147483648)), 2147549183);
    assert_eq!(uvec2(0, 1).chebyshev_distance(uvec2(65536, 2147483648)), 2147483647);
    assert_eq!(uvec2(1, 2).checked_manhattan_distance(uvec2(2, 65535)), Some(65534));
    assert_eq!(uvec2(1, 2).manhattan_distance(uvec2(2, 65535)), 65534);
    assert_eq!(uvec2(1, 2).chebyshev_distance(uvec2(2, 65535)), 65533);
