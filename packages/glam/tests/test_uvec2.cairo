#[test]
fn test_bit_ops() {
    assert_eq!(uvec2(0, 1) & uvec2(1, 7), uvec2(0, 1));
    assert_eq!(uvec2(0, 1) | uvec2(1, 7), uvec2(1, 7));
    assert_eq!(uvec2(0, 1) ^ uvec2(1, 7), uvec2(1, 6));
    assert_eq!(~uvec2(0, 1), uvec2(4294967295, 4294967294));
    assert_eq!(uvec2(0, 1) & uvec2(7, 65536), uvec2(0, 0));
    assert_eq!(uvec2(0, 1) | uvec2(7, 65536), uvec2(7, 65537));
    assert_eq!(uvec2(0, 1) ^ uvec2(7, 65536), uvec2(7, 65537));
    assert_eq!(~uvec2(0, 1), uvec2(4294967295, 4294967294));
    assert_eq!(uvec2(0, 1) & uvec2(65536, 2147483648), uvec2(0, 0));
