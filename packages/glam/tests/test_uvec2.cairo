    assert_eq!(uvec2(0, 1) ^ uvec2(65536, 2147483648), uvec2(65536, 2147483649));
    assert_eq!(~uvec2(0, 1), uvec2(4294967295, 4294967294));
    assert_eq!(uvec2(1, 2) & uvec2(2, 65535), uvec2(0, 2));
    assert_eq!(uvec2(1, 2) | uvec2(2, 65535), uvec2(3, 65535));
