#[test]
fn test_checked() {
    assert_eq!(UVec2Trait::MAX.checked_add(UVec2Trait::ONE), None);
    assert_eq!(UVec2Trait::MAX.checked_add(UVec2Trait::X), None);
    assert_eq!(UVec2Trait::MAX.checked_add(UVec2Trait::Y), None);
    assert_eq!(UVec2Trait::MAX.checked_add(UVec2Trait::ZERO), Some(UVec2Trait::MAX));
    assert_eq!(UVec2Trait::MIN.checked_sub(UVec2Trait::ONE), None);
    assert_eq!(UVec2Trait::MIN.checked_sub(UVec2Trait::X), None);
    assert_eq!(UVec2Trait::MIN.checked_sub(UVec2Trait::Y), None);
    assert_eq!(UVec2Trait::MIN.checked_sub(UVec2Trait::ZERO), Some(UVec2Trait::MIN));
    assert_eq!(UVec2Trait::MAX.checked_mul(UVec2Trait::MAX), None);
    assert_eq!(UVec2Trait::MAX.checked_mul(UVec2Trait::ZERO), Some(UVec2Trait::ZERO));
    assert_eq!(UVec2Trait::MAX.checked_mul(UVec2Trait::ONE), Some(UVec2Trait::MAX));
    assert_eq!(UVec2Trait::ZERO.checked_mul(UVec2Trait::ZERO), Some(UVec2Trait::ZERO));
    assert_eq!(UVec2Trait::ONE.checked_mul(UVec2Trait::ONE), Some(UVec2Trait::ONE));
    assert_eq!(UVec2Trait::MAX.checked_div(UVec2Trait::ZERO), None);
    assert_eq!(UVec2Trait::MAX.checked_div(UVec2Trait::X), None);
    assert_eq!(UVec2Trait::MAX.checked_div(UVec2Trait::Y), None);
    assert_eq!(UVec2Trait::ZERO.checked_div(UVec2Trait::ONE), Some(UVec2Trait::ZERO));
    assert_eq!(UVec2Trait::MAX.checked_div(UVec2Trait::ONE), Some(UVec2Trait::MAX));
}

