    assert_eq!(uvec2(1, 2).chebyshev_distance(uvec2(2147483647, 2147483649)), 2147483647);
    assert_eq!(uvec2(1, 2).checked_manhattan_distance(uvec2(4294967295, 1)), Some(4294967295));
    assert_eq!(uvec2(1, 2).manhattan_distance(uvec2(4294967295, 1)), 4294967295);
