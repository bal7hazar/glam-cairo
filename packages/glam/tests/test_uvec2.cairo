    assert_eq!(uvec2(2, 7).checked_manhattan_distance(uvec2(65535, 2147483647)), Some(2147549173));
    assert_eq!(uvec2(2, 7).manhattan_distance(uvec2(65535, 2147483647)), 2147549173);
