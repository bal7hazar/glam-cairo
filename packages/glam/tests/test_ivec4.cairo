#[test]
fn test_manhattan_chebyshev_distance() {
    assert_eq!(ivec4(3, 27, 98, 5).manhattan_distance(ivec4(20, 65, 97, 9)), 60);
    assert_eq!(ivec4(3, 27, 98, 5).chebyshev_distance(ivec4(20, 65, 97, 9)), 38);
    assert_eq!(IVec4Trait::MIN.checked_manhattan_distance(IVec4Trait::MAX), None);
    assert_eq!(IVec4Trait::MIN.chebyshev_distance(IVec4Trait::MAX), 4294967295);
    assert_eq!(IVec4Trait::MAX.chebyshev_distance(IVec4Trait::MIN), 4294967295);
    assert_eq!(IVec4Trait::MIN.manhattan_distance(IVec4Trait::MIN.with_x(2147483647)), 4294967295);
    assert_eq!(ivec4(-23, 2, -99, 4).manhattan_distance(ivec4(22, -12, 24, -4)), 190);
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341)
            .checked_manhattan_distance(ivec4(-2147483647, -46341, -1, 1)),
        Some(2147549184),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341)
            .manhattan_distance(ivec4(-2147483647, -46341, -1, 1)),
        2147549184,
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341)
            .chebyshev_distance(ivec4(-2147483647, -46341, -1, 1)),
        2147437306,
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341)
            .checked_manhattan_distance(ivec4(-46341, -1, 1, 5)),
        None,
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341).chebyshev_distance(ivec4(-46341, -1, 1, 5)),
        2147483646,
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341)
            .checked_manhattan_distance(ivec4(-1, 1, 5, 65536)),
        None,
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341).chebyshev_distance(ivec4(-1, 1, 5, 65536)),
        2147483648,
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7).checked_manhattan_distance(ivec4(-65536, -7, 0, 2)),
        Some(2147529990),
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7).manhattan_distance(ivec4(-65536, -7, 0, 2)),
        2147529990,
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7).chebyshev_distance(ivec4(-65536, -7, 0, 2)),
        2147418111,
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7)
            .checked_manhattan_distance(ivec4(0, 2, 46340, 2147483646)),
        None,
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7).chebyshev_distance(ivec4(0, 2, 46340, 2147483646)),
        2147483653,
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7)
            .checked_manhattan_distance(ivec4(46340, 2147483646, -2147483648, -65536)),
