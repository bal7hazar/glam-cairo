    );
    assert_eq!(
        ivec4(2147483646, 2147483647, -2147483648, -2147483647)
            .rem_euclid(ivec4(5, 65536, 2147483647, -2147483647)),
        ivec4(1, 65535, 2147483646, 0),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536)
            .div_euclid(ivec4(-2147483648, -65536, -7, 3)),
        ivec4(0, 32768, 306783379, -21846),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536)
            .rem_euclid(ivec4(-2147483648, -65536, -7, 3)),
        ivec4(2147483647, 0, 6, 2),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536)
            .div_euclid(ivec4(-2147483648, -65536, -7, 3)),
        ivec4(0, 32768, 306783379, -21846),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536)
            .rem_euclid(ivec4(-2147483648, -65536, -7, 3)),
        ivec4(2147483647, 0, 6, 2),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536)
            .div_euclid(ivec4(-2147483648, -65536, -7, 3)),
        ivec4(0, 32768, 306783379, -21846),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536)
            .rem_euclid(ivec4(-2147483648, -65536, -7, 3)),
        ivec4(2147483647, 0, 6, 2),
    );
    assert_eq!(IVec4Trait::MIN.rem_euclid(IVec4Trait::NEG_ONE), IVec4Trait::ZERO);
    assert_eq!(IVec4Trait::MIN.div_euclid(IVec4Trait::MIN), IVec4Trait::ONE);
    assert_eq!(IVec4Trait::MAX.div_euclid(IVec4Trait::MIN), IVec4Trait::ZERO);
    assert_eq!(IVec4Trait::MAX.rem_euclid(IVec4Trait::MIN), IVec4Trait::MAX);
    assert_eq!(IVec4Trait::MIN.div_euclid(IVec4Trait::ONE), IVec4Trait::MIN);
}

