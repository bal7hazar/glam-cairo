    );
    assert_eq!(
        ivec4(2147483646, 2147483647, -2147483648, -2147483647)
            .rem_euclid(ivec4(65536, 2147483647, -2147483647, -46341)),
        ivec4(65534, 0, 2147483646, 4634),
    );
    assert_eq!(
        ivec4(2147483646, 2147483647, -2147483648, -2147483647)
            .div_euclid(ivec4(5, 65536, 2147483647, -2147483647)),
