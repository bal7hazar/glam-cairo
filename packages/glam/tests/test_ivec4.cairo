#[test]
fn test_wrapping_saturating() {
    assert_eq!(
        ivec4(2147483647, 0, 5, 4).wrapping_add(ivec4(1, 2, 3, 2)), ivec4(-2147483648, 2, 8, 6),
    );
    assert_eq!(
        ivec4(-2147483648, 4, 5, 4).wrapping_sub(ivec4(1, 2, 3, 2)), ivec4(2147483647, 2, 2, 2),
    );
    assert_eq!(
        ivec4(2147483647, 2, 5, 4).wrapping_mul(ivec4(3, 2, 3, 2)), ivec4(2147483645, 4, 15, 8),
    );
    assert_eq!(
        ivec4(2147483647, 2, 5, 4).wrapping_div(ivec4(3, 2, 3, 2)), ivec4(715827882, 1, 1, 2),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, 0, 0).saturating_add(ivec4(1, -1, 0, 0)),
        ivec4(2147483647, -2147483648, 0, 0),
    );
    assert_eq!(
        ivec4(-2147483648, 2147483647, 0, 0).saturating_sub(ivec4(1, -1, 0, 0)),
        ivec4(-2147483648, 2147483647, 0, 0),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, 0, 0).saturating_mul(ivec4(2, 2, 0, 0)),
        ivec4(2147483647, -2147483648, 0, 0),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, 0, 0).saturating_div(ivec4(2, 2, 3, 4)),
        ivec4(1073741823, -1073741824, 0, 0),
    );
    assert_eq!(IVec4Trait::MIN.wrapping_div(IVec4Trait::NEG_ONE), IVec4Trait::MIN);
    assert_eq!(IVec4Trait::MIN.saturating_div(IVec4Trait::NEG_ONE), IVec4Trait::MAX);
}

#[test]
fn test_unsigned_ops() {
    assert_eq!(IVec4Trait::MAX.checked_add_unsigned(UVec4Trait::ONE), None);
    assert_eq!(IVec4Trait::NEG_ONE.checked_add_unsigned(UVec4Trait::ONE), Some(IVec4Trait::ZERO));
    assert_eq!(IVec4Trait::MIN.checked_sub_unsigned(UVec4Trait::ONE), None);
    assert_eq!(IVec4Trait::ZERO.checked_sub_unsigned(UVec4Trait::ONE), Some(IVec4Trait::NEG_ONE));
    assert_eq!(IVec4Trait::MAX.wrapping_add_unsigned(UVec4Trait::ONE), IVec4Trait::MIN);
    assert_eq!(IVec4Trait::MIN.wrapping_sub_unsigned(UVec4Trait::ONE), IVec4Trait::MAX);
    assert_eq!(IVec4Trait::MAX.saturating_add_unsigned(UVec4Trait::ONE), IVec4Trait::MAX);
    assert_eq!(IVec4Trait::MIN.saturating_sub_unsigned(UVec4Trait::ONE), IVec4Trait::MIN);
    assert_eq!(IVec4Trait::MIN.checked_add_unsigned(UVec4Trait::MAX), Some(IVec4Trait::MAX));
