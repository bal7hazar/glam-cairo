#[test]
fn test_neg() {
    assert_eq!(-ivec4(1, 2, 3, 4), ivec4(-1, -2, -3, -4));
    assert_eq!(-IVec4Trait::ZERO, IVec4Trait::ZERO);
    assert_eq!(-IVec4Trait::MAX, ivec4(-2147483647, -2147483647, -2147483647, -2147483647));
    assert_eq!(-IVec4Trait::ONE, IVec4Trait::NEG_ONE);
}

#[test]
fn test_is_negative() {
    assert_eq!(ivec4(1, 2, 3, 4).is_negative_bitmask(), 0);
    assert_eq!(ivec4(1, 2, 3, 4).is_negative_mask(), bvec4(false, false, false, false));
    assert_eq!(ivec4(-1, 2, 3, 4).is_negative_bitmask(), 1);
    assert_eq!(ivec4(-1, 2, 3, 4).is_negative_mask(), bvec4(true, false, false, false));
    assert_eq!(ivec4(1, -2, 3, 4).is_negative_bitmask(), 2);
    assert_eq!(ivec4(1, -2, 3, 4).is_negative_mask(), bvec4(false, true, false, false));
    assert_eq!(ivec4(-1, -2, 3, 4).is_negative_bitmask(), 3);
    assert_eq!(ivec4(-1, -2, 3, 4).is_negative_mask(), bvec4(true, true, false, false));
    assert_eq!(ivec4(1, 2, -3, 4).is_negative_bitmask(), 4);
    assert_eq!(ivec4(1, 2, -3, 4).is_negative_mask(), bvec4(false, false, true, false));
    assert_eq!(ivec4(-1, 2, -3, 4).is_negative_bitmask(), 5);
    assert_eq!(ivec4(-1, 2, -3, 4).is_negative_mask(), bvec4(true, false, true, false));
    assert_eq!(ivec4(1, -2, -3, 4).is_negative_bitmask(), 6);
    assert_eq!(ivec4(1, -2, -3, 4).is_negative_mask(), bvec4(false, true, true, false));
    assert_eq!(ivec4(-1, -2, -3, 4).is_negative_bitmask(), 7);
    assert_eq!(ivec4(-1, -2, -3, 4).is_negative_mask(), bvec4(true, true, true, false));
    assert_eq!(ivec4(1, 2, 3, -4).is_negative_bitmask(), 8);
    assert_eq!(ivec4(1, 2, 3, -4).is_negative_mask(), bvec4(false, false, false, true));
    assert_eq!(ivec4(-1, 2, 3, -4).is_negative_bitmask(), 9);
    assert_eq!(ivec4(-1, 2, 3, -4).is_negative_mask(), bvec4(true, false, false, true));
    assert_eq!(ivec4(1, -2, 3, -4).is_negative_bitmask(), 10);
    assert_eq!(ivec4(1, -2, 3, -4).is_negative_mask(), bvec4(false, true, false, true));
    assert_eq!(ivec4(-1, -2, 3, -4).is_negative_bitmask(), 11);
    assert_eq!(ivec4(-1, -2, 3, -4).is_negative_mask(), bvec4(true, true, false, true));
    assert_eq!(ivec4(1, 2, -3, -4).is_negative_bitmask(), 12);
    assert_eq!(ivec4(1, 2, -3, -4).is_negative_mask(), bvec4(false, false, true, true));
    assert_eq!(ivec4(-1, 2, -3, -4).is_negative_bitmask(), 13);
    assert_eq!(ivec4(-1, 2, -3, -4).is_negative_mask(), bvec4(true, false, true, true));
    assert_eq!(ivec4(1, -2, -3, -4).is_negative_bitmask(), 14);
    assert_eq!(ivec4(1, -2, -3, -4).is_negative_mask(), bvec4(false, true, true, true));
    assert_eq!(ivec4(-1, -2, -3, -4).is_negative_bitmask(), 15);
    assert_eq!(ivec4(-1, -2, -3, -4).is_negative_mask(), bvec4(true, true, true, true));
    assert_eq!(IVec4Trait::ZERO.is_negative_bitmask(), 0);
    assert_eq!(IVec4Trait::MIN.is_negative_bitmask(), 15);
    assert_eq!(IVec4Trait::MAX.is_negative_bitmask(), 0);
}

#[test]
fn test_abs_signum() {
    assert_eq!(IVec4Trait::ZERO.abs(), IVec4Trait::ZERO);
    assert_eq!(IVec4Trait::ONE.abs(), IVec4Trait::ONE);
    assert_eq!(IVec4Trait::NEG_ONE.abs(), IVec4Trait::ONE);
    assert_eq!(IVec4Trait::ZERO.signum(), IVec4Trait::ZERO);
    assert_eq!(IVec4Trait::ONE.signum(), IVec4Trait::ONE);
    assert_eq!(IVec4Trait::NEG_ONE.signum(), IVec4Trait::NEG_ONE);
    assert_eq!(IVec4Trait::MIN.signum(), IVec4Trait::NEG_ONE);
    assert_eq!(IVec4Trait::MAX.signum(), IVec4Trait::ONE);
    assert_eq!(ivec4(-2147483648, -2147483647, -65536, -46341).signum(), ivec4(-1, -1, -1, -1));
