#[test]
fn test_bit_ops() {
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) & ivec4(-2147483647, -46341, -1, 1),
        ivec4(-2147483648, -2147483647, -65536, 1),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) | ivec4(-2147483647, -46341, -1, 1),
        ivec4(-2147483647, -46341, -1, -46341),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) ^ ivec4(-2147483647, -46341, -1, 1),
        ivec4(1, 2147437306, 65535, -46342),
    );
    assert_eq!(
        ~ivec4(-2147483648, -2147483647, -65536, -46341),
        ivec4(2147483647, 2147483646, 65535, 46340),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) & ivec4(-46341, -1, 1, 5),
        ivec4(-2147483648, -2147483647, 0, 1),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) | ivec4(-46341, -1, 1, 5),
        ivec4(-46341, -1, -65535, -46337),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) ^ ivec4(-46341, -1, 1, 5),
        ivec4(2147437307, 2147483646, -65535, -46338),
    );
    assert_eq!(
        ~ivec4(-2147483648, -2147483647, -65536, -46341),
        ivec4(2147483647, 2147483646, 65535, 46340),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) & ivec4(-1, 1, 5, 65536),
        ivec4(-2147483648, 1, 0, 65536),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) | ivec4(-1, 1, 5, 65536),
        ivec4(-1, -2147483647, -65531, -46341),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341) ^ ivec4(-1, 1, 5, 65536),
        ivec4(2147483647, -2147483648, -65531, -111877),
    );
    assert_eq!(
        ~ivec4(-2147483648, -2147483647, -65536, -46341),
        ivec4(2147483647, 2147483646, 65535, 46340),
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7) & ivec4(-65536, -7, 0, 2),
        ivec4(-2147483648, -65536, 0, 0),
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7) | ivec4(-65536, -7, 0, 2),
        ivec4(-65535, -7, -46341, -5),
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7) ^ ivec4(-65536, -7, 0, 2),
        ivec4(2147418113, 65529, -46341, -5),
    );
    assert_eq!(~ivec4(-2147483647, -65536, -46341, -7), ivec4(2147483646, 65535, 46340, 6));
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7) & ivec4(0, 2, 46340, 2147483646),
        ivec4(0, 0, 0, 2147483640),
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7) | ivec4(0, 2, 46340, 2147483646),
        ivec4(-2147483647, -65534, -1, -1),
    );
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7) ^ ivec4(0, 2, 46340, 2147483646),
        ivec4(-2147483647, -65534, -1, -2147483641),
