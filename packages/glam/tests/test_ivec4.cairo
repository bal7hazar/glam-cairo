#[test]
fn test_clamp() {
    assert_eq!(ivec4(0, 0, 0, 0).clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(1, 3, 3, 2));
    assert_eq!(ivec4(2, 2, 2, 2).clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(2, 3, 3, 2));
    assert_eq!(ivec4(4, 4, 4, 4).clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(4, 4, 4, 4));
    assert_eq!(ivec4(5, 5, 5, 5).clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(5, 5, 5, 5));
    assert_eq!(ivec4(6, 6, 6, 6).clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(6, 6, 6, 6));
    assert_eq!(ivec4(7, 7, 7, 7).clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(6, 7, 7, 7));
    assert_eq!(ivec4(9, 9, 9, 9).clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(6, 8, 8, 9));
    assert_eq!(IVec4Trait::MIN.clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(1, 3, 3, 2));
    assert_eq!(IVec4Trait::MAX.clamp(ivec4(1, 3, 3, 2), ivec4(6, 8, 8, 9)), ivec4(6, 8, 8, 9));
    assert_eq!(ivec4(1, 3, 3, 2).clamp(IVec4Trait::MIN, IVec4Trait::MAX), ivec4(1, 3, 3, 2));
}

#[test]
fn test_sum_product() {
    assert_eq!(ivec4(1, 2, 3, 4).element_sum(), 10);
    assert_eq!(ivec4(1, 2, 3, 4).element_product(), 24);
    assert_eq!(ivec4(3, -7, 11, -13).element_sum(), -6);
    assert_eq!(ivec4(3, -7, 11, -13).element_product(), 3003);
    assert_eq!(ivec4(-1, -2, -3, -4).element_sum(), -10);
    assert_eq!(ivec4(-1, -2, -3, -4).element_product(), 24);
    assert_eq!(ivec4(0, 1, -1, 2).element_sum(), 2);
    assert_eq!(ivec4(0, 1, -1, 2).element_product(), 0);
    assert_eq!(ivec4(100, -200, 300, -400).element_sum(), -200);
}

