#[test]
fn test_checked() {
    assert_eq!(IVec4Trait::MAX.checked_add(IVec4Trait::ONE), None);
    assert_eq!(IVec4Trait::MAX.checked_add(IVec4Trait::X), None);
    assert_eq!(IVec4Trait::MAX.checked_add(IVec4Trait::Y), None);
    assert_eq!(IVec4Trait::MAX.checked_add(IVec4Trait::Z), None);
    assert_eq!(IVec4Trait::MAX.checked_add(IVec4Trait::W), None);
    assert_eq!(IVec4Trait::MAX.checked_add(IVec4Trait::ZERO), Some(IVec4Trait::MAX));
    assert_eq!(IVec4Trait::MIN.checked_sub(IVec4Trait::ONE), None);
    assert_eq!(IVec4Trait::MIN.checked_sub(IVec4Trait::X), None);
    assert_eq!(IVec4Trait::MIN.checked_sub(IVec4Trait::Y), None);
    assert_eq!(IVec4Trait::MIN.checked_sub(IVec4Trait::Z), None);
    assert_eq!(IVec4Trait::MIN.checked_sub(IVec4Trait::W), None);
    assert_eq!(IVec4Trait::MIN.checked_sub(IVec4Trait::ZERO), Some(IVec4Trait::MIN));
    assert_eq!(IVec4Trait::MAX.checked_mul(IVec4Trait::MAX), None);
    assert_eq!(IVec4Trait::MAX.checked_mul(IVec4Trait::ZERO), Some(IVec4Trait::ZERO));
    assert_eq!(IVec4Trait::MAX.checked_mul(IVec4Trait::ONE), Some(IVec4Trait::MAX));
    assert_eq!(IVec4Trait::ZERO.checked_mul(IVec4Trait::ZERO), Some(IVec4Trait::ZERO));
    assert_eq!(IVec4Trait::ONE.checked_mul(IVec4Trait::ONE), Some(IVec4Trait::ONE));
    assert_eq!(IVec4Trait::MAX.checked_div(IVec4Trait::ZERO), None);
    assert_eq!(IVec4Trait::MAX.checked_div(IVec4Trait::X), None);
    assert_eq!(IVec4Trait::MAX.checked_div(IVec4Trait::Y), None);
    assert_eq!(IVec4Trait::MAX.checked_div(IVec4Trait::Z), None);
    assert_eq!(IVec4Trait::MAX.checked_div(IVec4Trait::W), None);
    assert_eq!(IVec4Trait::ZERO.checked_div(IVec4Trait::ONE), Some(IVec4Trait::ZERO));
    assert_eq!(IVec4Trait::MAX.checked_div(IVec4Trait::ONE), Some(IVec4Trait::MAX));
    assert_eq!(IVec4Trait::MIN.checked_mul(IVec4Trait::MIN), None);
    assert_eq!(IVec4Trait::MAX.checked_mul(IVec4Trait::MIN), None);
    assert_eq!(IVec4Trait::MIN.checked_mul(IVec4Trait::MAX), None);
    assert_eq!(IVec4Trait::ZERO.checked_mul(IVec4Trait::MIN), Some(IVec4Trait::ZERO));
    assert_eq!(IVec4Trait::MIN.checked_mul(IVec4Trait::ONE), Some(IVec4Trait::MIN));
