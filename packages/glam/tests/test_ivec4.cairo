        ivec4(2147483646, 2147483647, -2147483648, -2147483647).shl(16),
        ivec4(-131072, -65536, 0, 65536),
    );
    assert_eq!(
        ivec4(2147483646, 2147483647, -2147483648, -2147483647).shr(16),
        ivec4(32767, 32767, -32768, -32768),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536).shl(16), ivec4(-65536, 0, 65536, 0),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536).shr(16),
        ivec4(32767, -32768, -32768, -1),
    );
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341).shl(30),
        ivec4(0, 1073741824, 0, -1073741824),
    );
    assert_eq!(ivec4(-2147483648, -2147483647, -65536, -46341).shr(30), ivec4(-2, -2, -1, -1));
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7).shl(30),
        ivec4(1073741824, 0, -1073741824, 1073741824),
    );
    assert_eq!(ivec4(-2147483647, -65536, -46341, -7).shr(30), ivec4(-2, -1, -1, -1));
    assert_eq!(
        ivec4(-65536, -46341, -7, -1).shl(30), ivec4(0, -1073741824, 1073741824, -1073741824),
    );
    assert_eq!(ivec4(-65536, -46341, -7, -1).shr(30), ivec4(-1, -1, -1, -1));
    assert_eq!(ivec4(-46341, -7, -1, 0).shl(30), ivec4(-1073741824, 1073741824, -1073741824, 0));
    assert_eq!(ivec4(-46341, -7, -1, 0).shr(30), ivec4(-1, -1, -1, 0));
    assert_eq!(ivec4(-7, -1, 0, 1).shl(30), ivec4(1073741824, -1073741824, 0, 1073741824));
    assert_eq!(ivec4(-7, -1, 0, 1).shr(30), ivec4(-1, -1, 0, 0));
    assert_eq!(ivec4(-1, 0, 1, 2).shl(30), ivec4(-1073741824, 0, 1073741824, -2147483648));
    assert_eq!(ivec4(-1, 0, 1, 2).shr(30), ivec4(-1, 0, 0, 0));
    assert_eq!(ivec4(0, 1, 2, 5).shl(30), ivec4(0, 1073741824, -2147483648, 1073741824));
    assert_eq!(ivec4(0, 1, 2, 5).shr(30), ivec4(0, 0, 0, 0));
    assert_eq!(ivec4(1, 2, 5, 46340).shl(30), ivec4(1073741824, -2147483648, 1073741824, 0));
    assert_eq!(ivec4(1, 2, 5, 46340).shr(30), ivec4(0, 0, 0, 0));
    assert_eq!(ivec4(2, 5, 46340, 65536).shl(30), ivec4(-2147483648, 1073741824, 0, 0));
    assert_eq!(ivec4(2, 5, 46340, 65536).shr(30), ivec4(0, 0, 0, 0));
    assert_eq!(ivec4(5, 46340, 65536, 2147483646).shl(30), ivec4(1073741824, 0, 0, -2147483648));
    assert_eq!(ivec4(5, 46340, 65536, 2147483646).shr(30), ivec4(0, 0, 0, 1));
    assert_eq!(
        ivec4(46340, 65536, 2147483646, 2147483647).shl(30), ivec4(0, 0, -2147483648, -1073741824),
    );
    assert_eq!(ivec4(46340, 65536, 2147483646, 2147483647).shr(30), ivec4(0, 0, 1, 1));
    assert_eq!(
        ivec4(65536, 2147483646, 2147483647, -2147483648).shl(30),
        ivec4(0, -2147483648, -1073741824, 0),
    );
    assert_eq!(ivec4(65536, 2147483646, 2147483647, -2147483648).shr(30), ivec4(0, 1, 1, -2));
    assert_eq!(
        ivec4(2147483646, 2147483647, -2147483648, -2147483647).shl(30),
        ivec4(-2147483648, -1073741824, 0, 1073741824),
    );
    assert_eq!(
        ivec4(2147483646, 2147483647, -2147483648, -2147483647).shr(30), ivec4(1, 1, -2, -2),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536).shl(30),
        ivec4(-1073741824, 0, 1073741824, 0),
    );
    assert_eq!(ivec4(2147483647, -2147483648, -2147483647, -65536).shr(30), ivec4(1, -2, -2, -1));
    assert_eq!(
        ivec4(-2147483648, -2147483647, -65536, -46341).shl(31),
        ivec4(0, -2147483648, 0, -2147483648),
    );
    assert_eq!(ivec4(-2147483648, -2147483647, -65536, -46341).shr(31), ivec4(-1, -1, -1, -1));
    assert_eq!(
        ivec4(-2147483647, -65536, -46341, -7).shl(31),
        ivec4(-2147483648, 0, -2147483648, -2147483648),
    );
    assert_eq!(ivec4(-2147483647, -65536, -46341, -7).shr(31), ivec4(-1, -1, -1, -1));
    assert_eq!(
        ivec4(-65536, -46341, -7, -1).shl(31), ivec4(0, -2147483648, -2147483648, -2147483648),
    );
    assert_eq!(ivec4(-65536, -46341, -7, -1).shr(31), ivec4(-1, -1, -1, -1));
    assert_eq!(ivec4(-46341, -7, -1, 0).shl(31), ivec4(-2147483648, -2147483648, -2147483648, 0));
    assert_eq!(ivec4(-46341, -7, -1, 0).shr(31), ivec4(-1, -1, -1, 0));
    assert_eq!(ivec4(-7, -1, 0, 1).shl(31), ivec4(-2147483648, -2147483648, 0, -2147483648));
    assert_eq!(ivec4(-7, -1, 0, 1).shr(31), ivec4(-1, -1, 0, 0));
    assert_eq!(ivec4(-1, 0, 1, 2).shl(31), ivec4(-2147483648, 0, -2147483648, 0));
    assert_eq!(ivec4(-1, 0, 1, 2).shr(31), ivec4(-1, 0, 0, 0));
    assert_eq!(ivec4(0, 1, 2, 5).shl(31), ivec4(0, -2147483648, 0, -2147483648));
    assert_eq!(ivec4(0, 1, 2, 5).shr(31), ivec4(0, 0, 0, 0));
    assert_eq!(ivec4(1, 2, 5, 46340).shl(31), ivec4(-2147483648, 0, -2147483648, 0));
    assert_eq!(ivec4(1, 2, 5, 46340).shr(31), ivec4(0, 0, 0, 0));
    assert_eq!(ivec4(2, 5, 46340, 65536).shl(31), ivec4(0, -2147483648, 0, 0));
    assert_eq!(ivec4(2, 5, 46340, 65536).shr(31), ivec4(0, 0, 0, 0));
    assert_eq!(ivec4(5, 46340, 65536, 2147483646).shl(31), ivec4(-2147483648, 0, 0, 0));
    assert_eq!(ivec4(5, 46340, 65536, 2147483646).shr(31), ivec4(0, 0, 0, 0));
    assert_eq!(ivec4(46340, 65536, 2147483646, 2147483647).shl(31), ivec4(0, 0, 0, -2147483648));
    assert_eq!(ivec4(46340, 65536, 2147483646, 2147483647).shr(31), ivec4(0, 0, 0, 0));
    assert_eq!(
        ivec4(65536, 2147483646, 2147483647, -2147483648).shl(31), ivec4(0, 0, -2147483648, 0),
    );
    assert_eq!(ivec4(65536, 2147483646, 2147483647, -2147483648).shr(31), ivec4(0, 0, 0, -1));
    assert_eq!(
        ivec4(2147483646, 2147483647, -2147483648, -2147483647).shl(31),
        ivec4(0, -2147483648, 0, -2147483648),
    );
    assert_eq!(
        ivec4(2147483646, 2147483647, -2147483648, -2147483647).shr(31), ivec4(0, 0, -1, -1),
    );
    assert_eq!(
        ivec4(2147483647, -2147483648, -2147483647, -65536).shl(31),
        ivec4(-2147483648, 0, -2147483648, 0),
    );
    assert_eq!(ivec4(2147483647, -2147483648, -2147483647, -65536).shr(31), ivec4(0, -1, -1, -1));
}

#[test]
fn test_hash_serde() {
    let a = ivec4(1, 2, 3, 4);
    let b = ivec4(4, 3, 2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 4);
    let mut span = out.span();
    assert_eq!(Serde::<IVec4>::deserialize(ref span), Some(a));
}

