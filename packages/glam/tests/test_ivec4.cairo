fn test_dot_length() {
    assert_eq!(IVec4Trait::X.dot(IVec4Trait::X), 1);
    assert_eq!(IVec4Trait::X.dot(IVec4Trait::Y), 0);
    assert_eq!(ivec4(3, -7, 11, -13).dot(ivec4(-5, 2, 9, 4)), 18);
    assert_eq!(ivec4(3, -7, 11, -13).dot_into_vec(ivec4(-5, 2, 9, 4)), ivec4(18, 18, 18, 18));
    assert_eq!(ivec4(3, -7, 11, -13).length_squared(), 348);
    assert_eq!(ivec4(3, -7, 11, -13).distance_squared(ivec4(-5, 2, 9, 4)), 438);
    assert_eq!(ivec4(-1, -2, -3, -4).dot(ivec4(4, 3, 2, 1)), -20);
    assert_eq!(ivec4(-1, -2, -3, -4).dot_into_vec(ivec4(4, 3, 2, 1)), ivec4(-20, -20, -20, -20));
    assert_eq!(ivec4(-1, -2, -3, -4).length_squared(), 30);
    assert_eq!(ivec4(-1, -2, -3, -4).distance_squared(ivec4(4, 3, 2, 1)), 100);
    assert_eq!(ivec4(0, 1, -1, 2).dot(ivec4(7, -7, 7, -7)), -28);
    assert_eq!(ivec4(0, 1, -1, 2).dot_into_vec(ivec4(7, -7, 7, -7)), ivec4(-28, -28, -28, -28));
    assert_eq!(ivec4(0, 1, -1, 2).length_squared(), 6);
    assert_eq!(ivec4(0, 1, -1, 2).distance_squared(ivec4(7, -7, 7, -7)), 258);
    assert_eq!(ivec4(100, -200, 300, -400).dot(ivec4(-9, 8, -7, 6)), -7000);
    assert_eq!(
        ivec4(100, -200, 300, -400).dot_into_vec(ivec4(-9, 8, -7, 6)),
        ivec4(-7000, -7000, -7000, -7000),
    );
    assert_eq!(ivec4(100, -200, 300, -400).length_squared(), 300000);
    assert_eq!(ivec4(100, -200, 300, -400).distance_squared(ivec4(-9, 8, -7, 6)), 314230);
    assert_eq!(ivec4(46340, -3, 1, 0).dot(ivec4(46340, 5, -1, 5)), 2147395584);
    assert_eq!(
        ivec4(46340, -3, 1, 0).dot_into_vec(ivec4(46340, 5, -1, 5)),
        ivec4(2147395584, 2147395584, 2147395584, 2147395584),
    );
    assert_eq!(ivec4(46340, -3, 1, 0).length_squared(), 2147395610);
    assert_eq!(ivec4(46340, -3, 1, 0).distance_squared(ivec4(46340, 5, -1, 5)), 93);
}

