#[test]
#[fuzzer(runs: 256, seed: 4001)]
fn fuzz_wrapping_checked_saturating(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec4(a, b, a, b);
    let vb = ivec4(c, d, a, c);
    let exact = [wide(a) + wide(c), wide(b) + wide(d), wide(a) + wide(a), wide(b) + wide(c)];
    assert_eq!(va.wrapping_add(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_add(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_add(vb), map_checked(exact));
    let exact = [wide(a) - wide(c), wide(b) - wide(d), wide(a) - wide(a), wide(b) - wide(c)];
    assert_eq!(va.wrapping_sub(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_sub(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_sub(vb), map_checked(exact));
    let exact = [wide(a) * wide(c), wide(b) * wide(d), wide(a) * wide(a), wide(b) * wide(c)];
    assert_eq!(va.wrapping_mul(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_mul(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_mul(vb), map_checked(exact));
}

#[test]
#[fuzzer(runs: 256, seed: 4002)]
fn fuzz_min_max_clamp_select_cmp(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec4(a, b, a, b);
    let vb = ivec4(c, d, a, c);
    let lo = va.min(vb);
    let hi = va.max(vb);
    assert!(lo.cmple(hi).all());
    assert!(lo.cmple(va).all() && lo.cmple(vb).all());
    assert!(hi.cmpge(va).all() && hi.cmpge(vb).all());
    assert_eq!(IVec4Trait::select(va.cmplt(vb), va, vb), lo);
    assert_eq!(IVec4Trait::select(va.cmpgt(vb), va, vb), hi);
    assert_eq!(va.cmpeq(vb), !va.cmpne(vb));
    assert_eq!(va.cmpge(vb), !va.cmplt(vb));
    assert_eq!(va.cmple(vb), !va.cmpgt(vb));
    let vc = ivec4(d, a, c, d);
    let c = vc.clamp(lo, hi);
    assert_eq!(c, vc.max(lo).min(hi));
    assert!(lo.min_element() <= lo.max_element());
    assert_eq!(va[va.min_position()], va.min_element());
    assert_eq!(va[va.max_position()], va.max_element());
}

#[test]
#[fuzzer(runs: 256, seed: 4003)]
fn fuzz_distances(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec4(a, b, a, b);
    let vb = ivec4(c, d, a, c);
    let d = [
        abs_wide(wide(a) - wide(c)), abs_wide(wide(b) - wide(d)), abs_wide(wide(a) - wide(a)),
        abs_wide(wide(b) - wide(c)),
    ];
    let [dx, dy, dz, dw] = d;
    let sum = dx + dy + dz + dw;
    let expected: Option<u32> = sum.try_into();
    assert_eq!(va.checked_manhattan_distance(vb), expected);
    assert_eq!(vb.checked_manhattan_distance(va), expected);
    let mut m = dx;
    if dy > m {
        m = dy;
    }
    if dz > m {
        m = dz;
    }
    if dw > m {
        m = dw;
    }
    assert_eq!(wide_u(va.chebyshev_distance(vb)), m);
}

#[test]
#[fuzzer(runs: 256, seed: 4004)]
fn fuzz_dot_sum_product(a: i32, b: i32, c: i32, d: i32) {
    // 14-bit operands: nothing overflows
    let va = ivec4(a / 0x40000, b / 0x40000, a / 0x40000, b / 0x40000);
    let vb = ivec4(c / 0x40000, d / 0x40000, a / 0x40000, c / 0x40000);
    let expected = wide(a / 0x40000) * wide(c / 0x40000)
        + wide(b / 0x40000) * wide(d / 0x40000)
        + wide(a / 0x40000) * wide(a / 0x40000)
        + wide(b / 0x40000) * wide(c / 0x40000);
    assert_eq!(wide(va.dot(vb)), expected);
    assert_eq!(va.dot(vb), vb.dot(va));
    assert_eq!(va.length_squared(), va.dot(va));
    assert_eq!(
        wide(va.element_sum()),
        wide(a / 0x40000) + wide(b / 0x40000) + wide(a / 0x40000) + wide(b / 0x40000),
    );
    let tiny = ivec4(a / 0x1000000, b / 0x1000000, a / 0x1000000, b / 0x1000000);
    assert_eq!(
        wide(tiny.element_product()),
        wide(a / 0x1000000) * wide(b / 0x1000000) * wide(a / 0x1000000) * wide(b / 0x1000000),
    );
    assert_eq!(
        wide(va.distance_squared(vb)),
        (wide(a / 0x40000) - wide(c / 0x40000)) * (wide(a / 0x40000) - wide(c / 0x40000))
            + (wide(b / 0x40000) - wide(d / 0x40000)) * (wide(b / 0x40000) - wide(d / 0x40000))
            + (wide(a / 0x40000) - wide(a / 0x40000)) * (wide(a / 0x40000) - wide(a / 0x40000))
            + (wide(b / 0x40000) - wide(c / 0x40000)) * (wide(b / 0x40000) - wide(c / 0x40000)),
    );
}

#[test]
#[fuzzer(runs: 256, seed: 4005)]
fn fuzz_casts_bits_shifts(a: i32, b: i32, k: u32) {
    let va = ivec4(a, b, a, b);
    let vb = ivec4(b, a, a, b);
    assert_eq!(va.as_uvec4().as_ivec4(), va);
    assert_eq!(wide_o(va.as_uvec4().x), wrap_o(wide(a)));
    // (a & b) + (a | b) == a + b and (a ^ b) + 2 * (a & b) == a + b
    assert_eq!(wide((va & vb).x) + wide((va | vb).x), wide(a) + wide(b));
    assert_eq!(wide((va ^ vb).x) + 2 * wide((va & vb).x), wide(a) + wide(b));
    assert_eq!((va ^ vb) ^ vb, va);
    assert_eq!(~(va & vb), ~va | ~vb);
    assert_eq!(wide((~va).x), -1 - wide(a));
    let k = k % 32;
    let p = pow2(k);
    assert_eq!(wide(va.shl(k).x), wrap(wide(a) * p));
    assert_eq!(wide(va.shr(k).x), floor_div(wide(a), p));
}

#[test]
#[fuzzer(runs: 256, seed: 4006)]
fn fuzz_div_euclid_rem_euclid(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec4(a, b, a, b);
    let vb = ivec4(nz(c), nz(d), nz(a), nz(c));
    if !((a == -2147483648 && nz(c) == -1)
        || (b == -2147483648 && nz(d) == -1)
        || (a == -2147483648 && nz(a) == -1)
        || (b == -2147483648 && nz(c) == -1)) {
        let q = va.div_euclid(vb);
        let r = va.rem_euclid(vb);
        assert!(r.cmpge(IVec4Trait::ZERO).all());
        assert!(wide(r.x) < abs_wide(wide(vb.x)));
        assert!(wide(r.y) < abs_wide(wide(vb.y)));
        assert!(wide(r.z) < abs_wide(wide(vb.z)));
        assert!(wide(r.w) < abs_wide(wide(vb.w)));
        assert_eq!(wide(q.x) * wide(vb.x) + wide(r.x), wide(va.x));
        assert_eq!(wide(q.y) * wide(vb.y) + wide(r.y), wide(va.y));
        assert_eq!(wide(q.z) * wide(vb.z) + wide(r.z), wide(va.z));
        assert_eq!(wide(q.w) * wide(vb.w) + wide(r.w), wide(va.w));
        let tq = va / vb;
        let tr = va % vb;
        assert_eq!(wide(tq.x) * wide(vb.x) + wide(tr.x), wide(va.x));
        assert_eq!(wide(tq.y) * wide(vb.y) + wide(tr.y), wide(va.y));
        assert_eq!(wide(tq.z) * wide(vb.z) + wide(tr.z), wide(va.z));
        assert_eq!(wide(tq.w) * wide(vb.w) + wide(tr.w), wide(va.w));
        assert!(abs_wide(wide(tr.x)) < abs_wide(wide(vb.x)));
        assert!(abs_wide(wide(tr.y)) < abs_wide(wide(vb.y)));
        assert!(abs_wide(wide(tr.z)) < abs_wide(wide(vb.z)));
        assert!(abs_wide(wide(tr.w)) < abs_wide(wide(vb.w)));
        assert!(wide(tr.x) == 0 || (tr.x < 0) == (va.x < 0));
        assert!(wide(tr.y) == 0 || (tr.y < 0) == (va.y < 0));
        assert!(wide(tr.z) == 0 || (tr.z < 0) == (va.z < 0));
        assert!(wide(tr.w) == 0 || (tr.w < 0) == (va.w < 0));
        assert_eq!(va.wrapping_div(vb), tq);
    }
}

#[test]
#[fuzzer(runs: 256, seed: 4007)]
fn fuzz_abs_signum_neg(a: i32, b: i32) {
    let a = if a == -2147483648 {
        0
    } else {
        a
    };
    let b = if b == -2147483648 {
        0
    } else {
        b
    };
    let va = ivec4(a, b, a, b);
    assert_eq!(va.signum() * va.abs(), va);
    assert_eq!((-va).abs(), va.abs());
    assert_eq!(-(-va), va);
    assert!(va.abs().cmpge(IVec4Trait::ZERO).all());
    assert_eq!(va.is_negative_mask(), va.cmplt(IVec4Trait::ZERO));
    assert_eq!(va.is_negative_bitmask(), va.is_negative_mask().bitmask());
}

#[test]
#[fuzzer(runs: 256, seed: 4008)]
fn fuzz_mixed_sign_ops(a: i32, b: i32, c: u32, d: u32) {
    let va = ivec4(a, b, a, b);
    let vb = uvec4(c, d, c, d);
    let exact = [
        wide(a) + wide_o(c), wide(b) + wide_o(d), wide(a) + wide_o(c), wide(b) + wide_o(d),
    ];
    assert_eq!(va.wrapping_add_unsigned(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_add_unsigned(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_add_unsigned(vb), map_checked(exact));
    let exact = [
        wide(a) - wide_o(c), wide(b) - wide_o(d), wide(a) - wide_o(c), wide(b) - wide_o(d),
    ];
    assert_eq!(va.wrapping_sub_unsigned(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_sub_unsigned(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_sub_unsigned(vb), map_checked(exact));
}
