#[test]
fn test_wrapping_saturating() {
    assert_eq!(uvec3(4294967295, 0, 5).wrapping_add(uvec3(1, 2, 3)), uvec3(0, 2, 8));
    assert_eq!(uvec3(0, 4, 5).wrapping_sub(uvec3(1, 2, 3)), uvec3(4294967295, 2, 2));
    assert_eq!(uvec3(4294967295, 2, 5).wrapping_mul(uvec3(3, 2, 3)), uvec3(4294967293, 4, 15));
    assert_eq!(uvec3(4294967295, 2, 5).wrapping_div(uvec3(3, 2, 3)), uvec3(1431655765, 1, 1));
    assert_eq!(
        uvec3(4294967295, 4294967295, 0).saturating_add(uvec3(1, 4294967295, 2)),
        uvec3(4294967295, 4294967295, 2),
    );
    assert_eq!(uvec3(0, 4294967295, 0).saturating_sub(uvec3(1, 1, 2)), uvec3(0, 4294967294, 0));
    assert_eq!(
        uvec3(4294967295, 4294967295, 0).saturating_mul(uvec3(2, 4294967295, 3)),
        uvec3(4294967295, 4294967295, 0),
    );
    assert_eq!(
        uvec3(4294967295, 4294967295, 0).saturating_div(uvec3(2, 4294967295, 3)),
        uvec3(2147483647, 1, 0),
    );
}

