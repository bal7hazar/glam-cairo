    assert_eq!(uvec3(1, 2, 7).shl(30), uvec3(1073741824, 2147483648, 3221225472));
    assert_eq!(uvec3(1, 2, 7).shr(30), uvec3(0, 0, 0));
    assert_eq!(uvec3(2, 7, 65535).shl(30), uvec3(2147483648, 3221225472, 3221225472));
    assert_eq!(uvec3(2, 7, 65535).shr(30), uvec3(0, 0, 0));
    assert_eq!(uvec3(7, 65535, 65536).shl(30), uvec3(3221225472, 3221225472, 0));
    assert_eq!(uvec3(7, 65535, 65536).shr(30), uvec3(0, 0, 0));
    assert_eq!(uvec3(65535, 65536, 2147483647).shl(30), uvec3(3221225472, 0, 3221225472));
    assert_eq!(uvec3(65535, 65536, 2147483647).shr(30), uvec3(0, 0, 1));
    assert_eq!(uvec3(65536, 2147483647, 2147483648).shl(30), uvec3(0, 3221225472, 0));
    assert_eq!(uvec3(65536, 2147483647, 2147483648).shr(30), uvec3(0, 1, 2));
    assert_eq!(uvec3(2147483647, 2147483648, 2147483649).shl(30), uvec3(3221225472, 0, 1073741824));
    assert_eq!(uvec3(2147483647, 2147483648, 2147483649).shr(30), uvec3(1, 2, 2));
    assert_eq!(uvec3(2147483648, 2147483649, 4294967294).shl(30), uvec3(0, 1073741824, 2147483648));
    assert_eq!(uvec3(2147483648, 2147483649, 4294967294).shr(30), uvec3(2, 2, 3));
    assert_eq!(
        uvec3(2147483649, 4294967294, 4294967295).shl(30),
        uvec3(1073741824, 2147483648, 3221225472),
    );
    assert_eq!(uvec3(2147483649, 4294967294, 4294967295).shr(30), uvec3(2, 3, 3));
    assert_eq!(uvec3(4294967294, 4294967295, 0).shl(30), uvec3(2147483648, 3221225472, 0));
    assert_eq!(uvec3(4294967294, 4294967295, 0).shr(30), uvec3(3, 3, 0));
    assert_eq!(uvec3(4294967295, 0, 1).shl(30), uvec3(3221225472, 0, 1073741824));
    assert_eq!(uvec3(4294967295, 0, 1).shr(30), uvec3(3, 0, 0));
    assert_eq!(uvec3(0, 1, 2).shl(31), uvec3(0, 2147483648, 0));
    assert_eq!(uvec3(0, 1, 2).shr(31), uvec3(0, 0, 0));
    assert_eq!(uvec3(1, 2, 7).shl(31), uvec3(2147483648, 0, 2147483648));
    assert_eq!(uvec3(1, 2, 7).shr(31), uvec3(0, 0, 0));
    assert_eq!(uvec3(2, 7, 65535).shl(31), uvec3(0, 2147483648, 2147483648));
    assert_eq!(uvec3(2, 7, 65535).shr(31), uvec3(0, 0, 0));
    assert_eq!(uvec3(7, 65535, 65536).shl(31), uvec3(2147483648, 2147483648, 0));
    assert_eq!(uvec3(7, 65535, 65536).shr(31), uvec3(0, 0, 0));
    assert_eq!(uvec3(65535, 65536, 2147483647).shl(31), uvec3(2147483648, 0, 2147483648));
    assert_eq!(uvec3(65535, 65536, 2147483647).shr(31), uvec3(0, 0, 0));
    assert_eq!(uvec3(65536, 2147483647, 2147483648).shl(31), uvec3(0, 2147483648, 0));
    assert_eq!(uvec3(65536, 2147483647, 2147483648).shr(31), uvec3(0, 0, 1));
    assert_eq!(uvec3(2147483647, 2147483648, 2147483649).shl(31), uvec3(2147483648, 0, 2147483648));
    assert_eq!(uvec3(2147483647, 2147483648, 2147483649).shr(31), uvec3(0, 1, 1));
    assert_eq!(uvec3(2147483648, 2147483649, 4294967294).shl(31), uvec3(0, 2147483648, 0));
    assert_eq!(uvec3(2147483648, 2147483649, 4294967294).shr(31), uvec3(1, 1, 1));
    assert_eq!(uvec3(2147483649, 4294967294, 4294967295).shl(31), uvec3(2147483648, 0, 2147483648));
    assert_eq!(uvec3(2147483649, 4294967294, 4294967295).shr(31), uvec3(1, 1, 1));
    assert_eq!(uvec3(4294967294, 4294967295, 0).shl(31), uvec3(0, 2147483648, 0));
    assert_eq!(uvec3(4294967294, 4294967295, 0).shr(31), uvec3(1, 1, 0));
    assert_eq!(uvec3(4294967295, 0, 1).shl(31), uvec3(2147483648, 0, 2147483648));
    assert_eq!(uvec3(4294967295, 0, 1).shr(31), uvec3(1, 0, 0));
}

#[test]
fn test_hash_serde() {
    let a = uvec3(1, 2, 3);
    let b = uvec3(3, 2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 3);
    let mut span = out.span();
    assert_eq!(Serde::<UVec3>::deserialize(ref span), Some(a));
}

