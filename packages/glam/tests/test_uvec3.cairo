#[test]
fn test_assign_ops() {
    let mut a = uvec3(20, 40, 80);
    a += uvec3(2, 3, 7);
    assert_eq!(a, uvec3(22, 43, 87));
    let mut a = uvec3(20, 40, 80);
    a += 3;
    assert_eq!(a, uvec3(23, 43, 83));
    let mut a = uvec3(20, 40, 80);
    a -= uvec3(2, 3, 7);
    assert_eq!(a, uvec3(18, 37, 73));
    let mut a = uvec3(20, 40, 80);
    a -= 3;
    assert_eq!(a, uvec3(17, 37, 77));
    let mut a = uvec3(20, 40, 80);
    a *= uvec3(2, 3, 7);
    assert_eq!(a, uvec3(40, 120, 560));
    let mut a = uvec3(20, 40, 80);
    a *= 3;
    assert_eq!(a, uvec3(60, 120, 240));
    let mut a = uvec3(20, 40, 80);
    a /= uvec3(2, 3, 7);
    assert_eq!(a, uvec3(10, 13, 11));
    let mut a = uvec3(20, 40, 80);
    a /= 3;
    assert_eq!(a, uvec3(6, 13, 26));
    let mut a = uvec3(20, 40, 80);
    a %= uvec3(2, 3, 7);
    assert_eq!(a, uvec3(0, 1, 3));
    let mut a = uvec3(20, 40, 80);
    a %= 3;
    assert_eq!(a, uvec3(2, 1, 2));
}

