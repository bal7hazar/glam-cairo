#[test]
fn test_checked() {
    assert_eq!(UVec3Trait::MAX.checked_add(UVec3Trait::ONE), None);
    assert_eq!(UVec3Trait::MAX.checked_add(UVec3Trait::X), None);
    assert_eq!(UVec3Trait::MAX.checked_add(UVec3Trait::Y), None);
    assert_eq!(UVec3Trait::MAX.checked_add(UVec3Trait::Z), None);
    assert_eq!(UVec3Trait::MAX.checked_add(UVec3Trait::ZERO), Some(UVec3Trait::MAX));
    assert_eq!(UVec3Trait::MIN.checked_sub(UVec3Trait::ONE), None);
    assert_eq!(UVec3Trait::MIN.checked_sub(UVec3Trait::X), None);
    assert_eq!(UVec3Trait::MIN.checked_sub(UVec3Trait::Y), None);
    assert_eq!(UVec3Trait::MIN.checked_sub(UVec3Trait::Z), None);
    assert_eq!(UVec3Trait::MIN.checked_sub(UVec3Trait::ZERO), Some(UVec3Trait::MIN));
    assert_eq!(UVec3Trait::MAX.checked_mul(UVec3Trait::MAX), None);
    assert_eq!(UVec3Trait::MAX.checked_mul(UVec3Trait::ZERO), Some(UVec3Trait::ZERO));
    assert_eq!(UVec3Trait::MAX.checked_mul(UVec3Trait::ONE), Some(UVec3Trait::MAX));
    assert_eq!(UVec3Trait::ZERO.checked_mul(UVec3Trait::ZERO), Some(UVec3Trait::ZERO));
    assert_eq!(UVec3Trait::ONE.checked_mul(UVec3Trait::ONE), Some(UVec3Trait::ONE));
    assert_eq!(UVec3Trait::MAX.checked_div(UVec3Trait::ZERO), None);
    assert_eq!(UVec3Trait::MAX.checked_div(UVec3Trait::X), None);
    assert_eq!(UVec3Trait::MAX.checked_div(UVec3Trait::Y), None);
    assert_eq!(UVec3Trait::MAX.checked_div(UVec3Trait::Z), None);
    assert_eq!(UVec3Trait::ZERO.checked_div(UVec3Trait::ONE), Some(UVec3Trait::ZERO));
    assert_eq!(UVec3Trait::MAX.checked_div(UVec3Trait::ONE), Some(UVec3Trait::MAX));
}

