#[test]
fn test_clamp() {
    assert_eq!(uvec3(0, 0, 0).clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(1, 3, 3));
    assert_eq!(uvec3(2, 2, 2).clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(2, 3, 3));
    assert_eq!(uvec3(4, 4, 4).clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(4, 4, 4));
    assert_eq!(uvec3(5, 5, 5).clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(5, 5, 5));
    assert_eq!(uvec3(6, 6, 6).clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(6, 6, 6));
    assert_eq!(uvec3(7, 7, 7).clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(6, 7, 7));
    assert_eq!(uvec3(9, 9, 9).clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(6, 8, 8));
    assert_eq!(UVec3Trait::MIN.clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(1, 3, 3));
    assert_eq!(UVec3Trait::MAX.clamp(uvec3(1, 3, 3), uvec3(6, 8, 8)), uvec3(6, 8, 8));
    assert_eq!(uvec3(1, 3, 3).clamp(UVec3Trait::MIN, UVec3Trait::MAX), uvec3(1, 3, 3));
}

#[test]
fn test_sum_product() {
    assert_eq!(uvec3(1, 2, 3).element_sum(), 6);
    assert_eq!(uvec3(1, 2, 3).element_product(), 6);
    assert_eq!(uvec3(30, 7, 110).element_sum(), 147);
    assert_eq!(uvec3(30, 7, 110).element_product(), 23100);
    assert_eq!(uvec3(1, 2, 3).element_sum(), 6);
    assert_eq!(uvec3(1, 2, 3).element_product(), 6);
    assert_eq!(uvec3(0, 1, 5).element_sum(), 6);
    assert_eq!(uvec3(0, 1, 5).element_product(), 0);
    assert_eq!(uvec3(100, 200, 300).element_sum(), 600);
    assert_eq!(uvec3(100, 200, 300).element_product(), 6000000);
}

