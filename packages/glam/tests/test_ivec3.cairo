#[test]
fn test_checked() {
    assert_eq!(IVec3Trait::MAX.checked_add(IVec3Trait::ONE), None);
    assert_eq!(IVec3Trait::MAX.checked_add(IVec3Trait::X), None);
    assert_eq!(IVec3Trait::MAX.checked_add(IVec3Trait::Y), None);
    assert_eq!(IVec3Trait::MAX.checked_add(IVec3Trait::Z), None);
    assert_eq!(IVec3Trait::MAX.checked_add(IVec3Trait::ZERO), Some(IVec3Trait::MAX));
    assert_eq!(IVec3Trait::MIN.checked_sub(IVec3Trait::ONE), None);
    assert_eq!(IVec3Trait::MIN.checked_sub(IVec3Trait::X), None);
    assert_eq!(IVec3Trait::MIN.checked_sub(IVec3Trait::Y), None);
    assert_eq!(IVec3Trait::MIN.checked_sub(IVec3Trait::Z), None);
    assert_eq!(IVec3Trait::MIN.checked_sub(IVec3Trait::ZERO), Some(IVec3Trait::MIN));
    assert_eq!(IVec3Trait::MAX.checked_mul(IVec3Trait::MAX), None);
    assert_eq!(IVec3Trait::MAX.checked_mul(IVec3Trait::ZERO), Some(IVec3Trait::ZERO));
    assert_eq!(IVec3Trait::MAX.checked_mul(IVec3Trait::ONE), Some(IVec3Trait::MAX));
    assert_eq!(IVec3Trait::ZERO.checked_mul(IVec3Trait::ZERO), Some(IVec3Trait::ZERO));
    assert_eq!(IVec3Trait::ONE.checked_mul(IVec3Trait::ONE), Some(IVec3Trait::ONE));
    assert_eq!(IVec3Trait::MAX.checked_div(IVec3Trait::ZERO), None);
    assert_eq!(IVec3Trait::MAX.checked_div(IVec3Trait::X), None);
    assert_eq!(IVec3Trait::MAX.checked_div(IVec3Trait::Y), None);
    assert_eq!(IVec3Trait::MAX.checked_div(IVec3Trait::Z), None);
    assert_eq!(IVec3Trait::ZERO.checked_div(IVec3Trait::ONE), Some(IVec3Trait::ZERO));
    assert_eq!(IVec3Trait::MAX.checked_div(IVec3Trait::ONE), Some(IVec3Trait::MAX));
    assert_eq!(IVec3Trait::MIN.checked_mul(IVec3Trait::MIN), None);
    assert_eq!(IVec3Trait::MAX.checked_mul(IVec3Trait::MIN), None);
    assert_eq!(IVec3Trait::MIN.checked_mul(IVec3Trait::MAX), None);
    assert_eq!(IVec3Trait::ZERO.checked_mul(IVec3Trait::MIN), Some(IVec3Trait::ZERO));
    assert_eq!(IVec3Trait::MIN.checked_mul(IVec3Trait::ONE), Some(IVec3Trait::MIN));
    assert_eq!(IVec3Trait::MIN.checked_div(IVec3Trait::ZERO), None);
    assert_eq!(IVec3Trait::MIN.checked_div(IVec3Trait::ONE), Some(IVec3Trait::MIN));
    assert_eq!(IVec3Trait::MIN.checked_div(IVec3Trait::NEG_ONE), None);
    assert_eq!(
        IVec3Trait::MAX.checked_div(IVec3Trait::NEG_ONE),
        Some(ivec3(-2147483647, -2147483647, -2147483647)),
    );
}

