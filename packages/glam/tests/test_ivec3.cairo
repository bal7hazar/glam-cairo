#[test]
fn test_bit_ops() {
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536) & ivec3(-2147483647, -46341, -1),
        ivec3(-2147483648, -2147483647, -65536),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536) | ivec3(-2147483647, -46341, -1),
        ivec3(-2147483647, -46341, -1),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536) ^ ivec3(-2147483647, -46341, -1),
        ivec3(1, 2147437306, 65535),
    );
    assert_eq!(~ivec3(-2147483648, -2147483647, -65536), ivec3(2147483647, 2147483646, 65535));
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536) & ivec3(-46341, -1, 1),
        ivec3(-2147483648, -2147483647, 0),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536) | ivec3(-46341, -1, 1), ivec3(-46341, -1, -65535),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536) ^ ivec3(-46341, -1, 1),
        ivec3(2147437307, 2147483646, -65535),
    );
    assert_eq!(~ivec3(-2147483648, -2147483647, -65536), ivec3(2147483647, 2147483646, 65535));
    assert_eq!(ivec3(-2147483648, -2147483647, -65536) & ivec3(-1, 1, 5), ivec3(-2147483648, 1, 0));
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536) | ivec3(-1, 1, 5), ivec3(-1, -2147483647, -65531),
