    assert_eq!(ivec3(2, 5, 46340).shr(30), ivec3(0, 0, 0));
    assert_eq!(ivec3(5, 46340, 65536).shl(30), ivec3(1073741824, 0, 0));
    assert_eq!(ivec3(5, 46340, 65536).shr(30), ivec3(0, 0, 0));
    assert_eq!(ivec3(46340, 65536, 2147483646).shl(30), ivec3(0, 0, -2147483648));
    assert_eq!(ivec3(46340, 65536, 2147483646).shr(30), ivec3(0, 0, 1));
    assert_eq!(ivec3(65536, 2147483646, 2147483647).shl(30), ivec3(0, -2147483648, -1073741824));
    assert_eq!(ivec3(65536, 2147483646, 2147483647).shr(30), ivec3(0, 1, 1));
    assert_eq!(
        ivec3(2147483646, 2147483647, -2147483648).shl(30), ivec3(-2147483648, -1073741824, 0),
    );
    assert_eq!(ivec3(2147483646, 2147483647, -2147483648).shr(30), ivec3(1, 1, -2));
    assert_eq!(
        ivec3(2147483647, -2147483648, -2147483647).shl(30), ivec3(-1073741824, 0, 1073741824),
    );
    assert_eq!(ivec3(2147483647, -2147483648, -2147483647).shr(30), ivec3(1, -2, -2));
    assert_eq!(ivec3(-2147483648, -2147483647, -65536).shl(31), ivec3(0, -2147483648, 0));
    assert_eq!(ivec3(-2147483648, -2147483647, -65536).shr(31), ivec3(-1, -1, -1));
    assert_eq!(ivec3(-2147483647, -65536, -46341).shl(31), ivec3(-2147483648, 0, -2147483648));
    assert_eq!(ivec3(-2147483647, -65536, -46341).shr(31), ivec3(-1, -1, -1));
    assert_eq!(ivec3(-65536, -46341, -7).shl(31), ivec3(0, -2147483648, -2147483648));
    assert_eq!(ivec3(-65536, -46341, -7).shr(31), ivec3(-1, -1, -1));
    assert_eq!(ivec3(-46341, -7, -1).shl(31), ivec3(-2147483648, -2147483648, -2147483648));
    assert_eq!(ivec3(-46341, -7, -1).shr(31), ivec3(-1, -1, -1));
    assert_eq!(ivec3(-7, -1, 0).shl(31), ivec3(-2147483648, -2147483648, 0));
    assert_eq!(ivec3(-7, -1, 0).shr(31), ivec3(-1, -1, 0));
    assert_eq!(ivec3(-1, 0, 1).shl(31), ivec3(-2147483648, 0, -2147483648));
    assert_eq!(ivec3(-1, 0, 1).shr(31), ivec3(-1, 0, 0));
    assert_eq!(ivec3(0, 1, 2).shl(31), ivec3(0, -2147483648, 0));
    assert_eq!(ivec3(0, 1, 2).shr(31), ivec3(0, 0, 0));
    assert_eq!(ivec3(1, 2, 5).shl(31), ivec3(-2147483648, 0, -2147483648));
    assert_eq!(ivec3(1, 2, 5).shr(31), ivec3(0, 0, 0));
    assert_eq!(ivec3(2, 5, 46340).shl(31), ivec3(0, -2147483648, 0));
    assert_eq!(ivec3(2, 5, 46340).shr(31), ivec3(0, 0, 0));
    assert_eq!(ivec3(5, 46340, 65536).shl(31), ivec3(-2147483648, 0, 0));
    assert_eq!(ivec3(5, 46340, 65536).shr(31), ivec3(0, 0, 0));
    assert_eq!(ivec3(46340, 65536, 2147483646).shl(31), ivec3(0, 0, 0));
    assert_eq!(ivec3(46340, 65536, 2147483646).shr(31), ivec3(0, 0, 0));
    assert_eq!(ivec3(65536, 2147483646, 2147483647).shl(31), ivec3(0, 0, -2147483648));
    assert_eq!(ivec3(65536, 2147483646, 2147483647).shr(31), ivec3(0, 0, 0));
    assert_eq!(ivec3(2147483646, 2147483647, -2147483648).shl(31), ivec3(0, -2147483648, 0));
    assert_eq!(ivec3(2147483646, 2147483647, -2147483648).shr(31), ivec3(0, 0, -1));
    assert_eq!(
        ivec3(2147483647, -2147483648, -2147483647).shl(31), ivec3(-2147483648, 0, -2147483648),
    );
    assert_eq!(ivec3(2147483647, -2147483648, -2147483647).shr(31), ivec3(0, -1, -1));
}

#[test]
fn test_hash_serde() {
    let a = ivec3(1, 2, 3);
    let b = ivec3(3, 2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 3);
    let mut span = out.span();
    assert_eq!(Serde::<IVec3>::deserialize(ref span), Some(a));
}

