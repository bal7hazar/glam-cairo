#[test]
fn test_clamp() {
    assert_eq!(ivec3(0, 0, 0).clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(1, 3, 3));
    assert_eq!(ivec3(2, 2, 2).clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(2, 3, 3));
    assert_eq!(ivec3(4, 4, 4).clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(4, 4, 4));
    assert_eq!(ivec3(5, 5, 5).clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(5, 5, 5));
    assert_eq!(ivec3(6, 6, 6).clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(6, 6, 6));
    assert_eq!(ivec3(7, 7, 7).clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(6, 7, 7));
    assert_eq!(ivec3(9, 9, 9).clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(6, 8, 8));
    assert_eq!(IVec3Trait::MIN.clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(1, 3, 3));
    assert_eq!(IVec3Trait::MAX.clamp(ivec3(1, 3, 3), ivec3(6, 8, 8)), ivec3(6, 8, 8));
    assert_eq!(ivec3(1, 3, 3).clamp(IVec3Trait::MIN, IVec3Trait::MAX), ivec3(1, 3, 3));
}

#[test]
fn test_sum_product() {
    assert_eq!(ivec3(1, 2, 3).element_sum(), 6);
    assert_eq!(ivec3(1, 2, 3).element_product(), 6);
    assert_eq!(ivec3(3, -7, 11).element_sum(), 7);
    assert_eq!(ivec3(3, -7, 11).element_product(), -231);
    assert_eq!(ivec3(-1, -2, -3).element_sum(), -6);
    assert_eq!(ivec3(-1, -2, -3).element_product(), -6);
    assert_eq!(ivec3(0, 1, -1).element_sum(), 0);
    assert_eq!(ivec3(0, 1, -1).element_product(), 0);
    assert_eq!(ivec3(100, -200, 300).element_sum(), 200);
    assert_eq!(ivec3(100, -200, 300).element_product(), -6000000);
}

