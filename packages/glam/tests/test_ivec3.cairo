#[test]
fn test_wrapping_saturating() {
    assert_eq!(ivec3(2147483647, 0, 5).wrapping_add(ivec3(1, 2, 3)), ivec3(-2147483648, 2, 8));
    assert_eq!(ivec3(-2147483648, 4, 5).wrapping_sub(ivec3(1, 2, 3)), ivec3(2147483647, 2, 2));
    assert_eq!(ivec3(2147483647, 2, 5).wrapping_mul(ivec3(3, 2, 3)), ivec3(2147483645, 4, 15));
    assert_eq!(ivec3(2147483647, 2, 5).wrapping_div(ivec3(3, 2, 3)), ivec3(715827882, 1, 1));
    assert_eq!(
        ivec3(2147483647, -2147483648, 0).saturating_add(ivec3(1, -1, 0)),
        ivec3(2147483647, -2147483648, 0),
    );
    assert_eq!(
        ivec3(-2147483648, 2147483647, 0).saturating_sub(ivec3(1, -1, 0)),
        ivec3(-2147483648, 2147483647, 0),
    );
    assert_eq!(
        ivec3(2147483647, -2147483648, 0).saturating_mul(ivec3(2, 2, 0)),
        ivec3(2147483647, -2147483648, 0),
    );
    assert_eq!(
        ivec3(2147483647, -2147483648, 0).saturating_div(ivec3(2, 2, 3)),
        ivec3(1073741823, -1073741824, 0),
    );
    assert_eq!(IVec3Trait::MIN.wrapping_div(IVec3Trait::NEG_ONE), IVec3Trait::MIN);
    assert_eq!(IVec3Trait::MIN.saturating_div(IVec3Trait::NEG_ONE), IVec3Trait::MAX);
}

