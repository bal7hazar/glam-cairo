fn fuzz_distances(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec3(a, b, a);
    let vb = ivec3(c, d, a);
    let d = [abs_wide(wide(a) - wide(c)), abs_wide(wide(b) - wide(d)), abs_wide(wide(a) - wide(a))];
    let [dx, dy, dz] = d;
    let sum = dx + dy + dz;
    let expected: Option<u32> = sum.try_into();
    assert_eq!(va.checked_manhattan_distance(vb), expected);
    assert_eq!(vb.checked_manhattan_distance(va), expected);
    let mut m = dx;
    if dy > m {
        m = dy;
    }
    if dz > m {
        m = dz;
    }
    assert_eq!(wide_u(va.chebyshev_distance(vb)), m);
}

#[test]
#[fuzzer(runs: 256, seed: 3004)]
fn fuzz_dot_sum_product(a: i32, b: i32, c: i32, d: i32) {
    // 14-bit operands: nothing overflows
    let va = ivec3(a / 0x40000, b / 0x40000, a / 0x40000);
    let vb = ivec3(c / 0x40000, d / 0x40000, a / 0x40000);
    let expected = wide(a / 0x40000) * wide(c / 0x40000)
        + wide(b / 0x40000) * wide(d / 0x40000)
        + wide(a / 0x40000) * wide(a / 0x40000);
    assert_eq!(wide(va.dot(vb)), expected);
    assert_eq!(va.dot(vb), vb.dot(va));
    assert_eq!(va.length_squared(), va.dot(va));
    assert_eq!(wide(va.element_sum()), wide(a / 0x40000) + wide(b / 0x40000) + wide(a / 0x40000));
    let tiny = ivec3(a / 0x1000000, b / 0x1000000, a / 0x1000000);
    assert_eq!(
        wide(tiny.element_product()),
        wide(a / 0x1000000) * wide(b / 0x1000000) * wide(a / 0x1000000),
    );
    assert_eq!(
        wide(va.distance_squared(vb)),
        (wide(a / 0x40000) - wide(c / 0x40000)) * (wide(a / 0x40000) - wide(c / 0x40000))
            + (wide(b / 0x40000) - wide(d / 0x40000)) * (wide(b / 0x40000) - wide(d / 0x40000))
            + (wide(a / 0x40000) - wide(a / 0x40000)) * (wide(a / 0x40000) - wide(a / 0x40000)),
    );
    let tb = ivec3(c / 0x1000000, d / 0x1000000, a / 0x1000000);
    let c = tiny.cross(tb);
    assert_eq!(c.dot(tiny), 0);
    assert_eq!(c.dot(tb), 0);
    assert_eq!(tb.cross(tiny), -c);
}

#[test]
#[fuzzer(runs: 256, seed: 3005)]
fn fuzz_casts_bits_shifts(a: i32, b: i32, k: u32) {
    let va = ivec3(a, b, a);
    let vb = ivec3(b, a, a);
    assert_eq!(va.as_uvec3().as_ivec3(), va);
    assert_eq!(wide_o(va.as_uvec3().x), wrap_o(wide(a)));
    // (a & b) + (a | b) == a + b and (a ^ b) + 2 * (a & b) == a + b
    assert_eq!(wide((va & vb).x) + wide((va | vb).x), wide(a) + wide(b));
    assert_eq!(wide((va ^ vb).x) + 2 * wide((va & vb).x), wide(a) + wide(b));
    assert_eq!((va ^ vb) ^ vb, va);
    assert_eq!(~(va & vb), ~va | ~vb);
    assert_eq!(wide((~va).x), -1 - wide(a));
    let k = k % 32;
    let p = pow2(k);
    assert_eq!(wide(va.shl(k).x), wrap(wide(a) * p));
    assert_eq!(wide(va.shr(k).x), floor_div(wide(a), p));
}

#[test]
#[fuzzer(runs: 256, seed: 3006)]
fn fuzz_div_euclid_rem_euclid(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec3(a, b, a);
    let vb = ivec3(nz(c), nz(d), nz(a));
    if !((a == -2147483648 && nz(c) == -1)
        || (b == -2147483648 && nz(d) == -1)
        || (a == -2147483648 && nz(a) == -1)) {
        let q = va.div_euclid(vb);
        let r = va.rem_euclid(vb);
        assert!(r.cmpge(IVec3Trait::ZERO).all());
        assert!(wide(r.x) < abs_wide(wide(vb.x)));
        assert!(wide(r.y) < abs_wide(wide(vb.y)));
        assert!(wide(r.z) < abs_wide(wide(vb.z)));
        assert_eq!(wide(q.x) * wide(vb.x) + wide(r.x), wide(va.x));
        assert_eq!(wide(q.y) * wide(vb.y) + wide(r.y), wide(va.y));
        assert_eq!(wide(q.z) * wide(vb.z) + wide(r.z), wide(va.z));
        let tq = va / vb;
        let tr = va % vb;
        assert_eq!(wide(tq.x) * wide(vb.x) + wide(tr.x), wide(va.x));
        assert_eq!(wide(tq.y) * wide(vb.y) + wide(tr.y), wide(va.y));
        assert_eq!(wide(tq.z) * wide(vb.z) + wide(tr.z), wide(va.z));
        assert!(abs_wide(wide(tr.x)) < abs_wide(wide(vb.x)));
        assert!(abs_wide(wide(tr.y)) < abs_wide(wide(vb.y)));
        assert!(abs_wide(wide(tr.z)) < abs_wide(wide(vb.z)));
        assert!(wide(tr.x) == 0 || (tr.x < 0) == (va.x < 0));
        assert!(wide(tr.y) == 0 || (tr.y < 0) == (va.y < 0));
        assert!(wide(tr.z) == 0 || (tr.z < 0) == (va.z < 0));
        assert_eq!(va.wrapping_div(vb), tq);
    }
}

#[test]
#[fuzzer(runs: 256, seed: 3007)]
fn fuzz_abs_signum_neg(a: i32, b: i32) {
    let a = if a == -2147483648 {
        0
    } else {
        a
    };
    let b = if b == -2147483648 {
        0
    } else {
        b
    };
    let va = ivec3(a, b, a);
    assert_eq!(va.signum() * va.abs(), va);
    assert_eq!((-va).abs(), va.abs());
    assert_eq!(-(-va), va);
    assert!(va.abs().cmpge(IVec3Trait::ZERO).all());
    assert_eq!(va.is_negative_mask(), va.cmplt(IVec3Trait::ZERO));
    assert_eq!(va.is_negative_bitmask(), va.is_negative_mask().bitmask());
}

