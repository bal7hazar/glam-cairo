#[test]
fn test_assign_ops() {
    let mut a = ivec3(20, 40, 80);
    a += ivec3(2, 3, 7);
    assert_eq!(a, ivec3(22, 43, 87));
    let mut a = ivec3(20, 40, 80);
    a += 3;
    assert_eq!(a, ivec3(23, 43, 83));
    let mut a = ivec3(20, 40, 80);
    a -= ivec3(2, 3, 7);
    assert_eq!(a, ivec3(18, 37, 73));
    let mut a = ivec3(20, 40, 80);
    a -= 3;
    assert_eq!(a, ivec3(17, 37, 77));
    let mut a = ivec3(20, 40, 80);
    a *= ivec3(2, 3, 7);
    assert_eq!(a, ivec3(40, 120, 560));
    let mut a = ivec3(20, 40, 80);
    a *= 3;
    assert_eq!(a, ivec3(60, 120, 240));
    let mut a = ivec3(20, 40, 80);
    a /= ivec3(2, 3, 7);
    assert_eq!(a, ivec3(10, 13, 11));
    let mut a = ivec3(20, 40, 80);
    a /= 3;
    assert_eq!(a, ivec3(6, 13, 26));
    let mut a = ivec3(20, 40, 80);
    a %= ivec3(2, 3, 7);
    assert_eq!(a, ivec3(0, 1, 3));
    let mut a = ivec3(20, 40, 80);
    a %= 3;
    assert_eq!(a, ivec3(2, 1, 2));
}

