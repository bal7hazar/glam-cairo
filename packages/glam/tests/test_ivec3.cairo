#[test]
fn test_neg() {
    assert_eq!(-ivec3(1, 2, 3), ivec3(-1, -2, -3));
    assert_eq!(-IVec3Trait::ZERO, IVec3Trait::ZERO);
    assert_eq!(-IVec3Trait::MAX, ivec3(-2147483647, -2147483647, -2147483647));
    assert_eq!(-IVec3Trait::ONE, IVec3Trait::NEG_ONE);
}

#[test]
fn test_is_negative() {
    assert_eq!(ivec3(1, 2, 3).is_negative_bitmask(), 0);
    assert_eq!(ivec3(1, 2, 3).is_negative_mask(), bvec3(false, false, false));
    assert_eq!(ivec3(-1, 2, 3).is_negative_bitmask(), 1);
