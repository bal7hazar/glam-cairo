    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_add(ivec3(-2147483647, -46341, -1)),
        ivec3(1, 2147437308, -65537),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_sub(ivec3(-2147483647, -46341, -1)),
        ivec3(-1, -2147437306, -65535),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_mul(ivec3(-2147483647, -46341, -1)),
        ivec3(-2147483648, 2147437307, 65536),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_div(ivec3(-2147483647, -46341, -1)),
        ivec3(1, 46340, 65536),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_add(ivec3(-46341, -1, 1)),
        ivec3(2147437307, -2147483648, -65535),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_sub(ivec3(-46341, -1, 1)),
        ivec3(-2147437307, -2147483646, -65537),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_mul(ivec3(-46341, -1, 1)),
        ivec3(-2147483648, 2147483647, -65536),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_div(ivec3(-46341, -1, 1)),
        ivec3(46340, 2147483647, -65536),
    );
    assert_eq!(
        ivec3(-2147483648, -2147483647, -65536).wrapping_add(ivec3(-1, 1, 5)),
        ivec3(2147483647, -2147483646, -65531),
