    assert_eq!(IVec3Trait::MIN.checked_sub_unsigned(UVec3Trait::ONE), None);
    assert_eq!(IVec3Trait::ZERO.checked_sub_unsigned(UVec3Trait::ONE), Some(IVec3Trait::NEG_ONE));
