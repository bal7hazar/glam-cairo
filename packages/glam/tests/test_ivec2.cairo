    assert_eq!(ivec2(2147483647, -2147483648).shl(30), ivec2(-1073741824, 0));
    assert_eq!(ivec2(2147483647, -2147483648).shr(30), ivec2(1, -2));
    assert_eq!(ivec2(-2147483648, -2147483647).shl(31), ivec2(0, -2147483648));
    assert_eq!(ivec2(-2147483648, -2147483647).shr(31), ivec2(-1, -1));
    assert_eq!(ivec2(-2147483647, -65536).shl(31), ivec2(-2147483648, 0));
    assert_eq!(ivec2(-2147483647, -65536).shr(31), ivec2(-1, -1));
    assert_eq!(ivec2(-65536, -46341).shl(31), ivec2(0, -2147483648));
    assert_eq!(ivec2(-65536, -46341).shr(31), ivec2(-1, -1));
    assert_eq!(ivec2(-46341, -7).shl(31), ivec2(-2147483648, -2147483648));
    assert_eq!(ivec2(-46341, -7).shr(31), ivec2(-1, -1));
    assert_eq!(ivec2(-7, -1).shl(31), ivec2(-2147483648, -2147483648));
    assert_eq!(ivec2(-7, -1).shr(31), ivec2(-1, -1));
    assert_eq!(ivec2(-1, 0).shl(31), ivec2(-2147483648, 0));
    assert_eq!(ivec2(-1, 0).shr(31), ivec2(-1, 0));
    assert_eq!(ivec2(0, 1).shl(31), ivec2(0, -2147483648));
    assert_eq!(ivec2(0, 1).shr(31), ivec2(0, 0));
    assert_eq!(ivec2(1, 2).shl(31), ivec2(-2147483648, 0));
    assert_eq!(ivec2(1, 2).shr(31), ivec2(0, 0));
    assert_eq!(ivec2(2, 5).shl(31), ivec2(0, -2147483648));
    assert_eq!(ivec2(2, 5).shr(31), ivec2(0, 0));
    assert_eq!(ivec2(5, 46340).shl(31), ivec2(-2147483648, 0));
    assert_eq!(ivec2(5, 46340).shr(31), ivec2(0, 0));
    assert_eq!(ivec2(46340, 65536).shl(31), ivec2(0, 0));
    assert_eq!(ivec2(46340, 65536).shr(31), ivec2(0, 0));
    assert_eq!(ivec2(65536, 2147483646).shl(31), ivec2(0, 0));
    assert_eq!(ivec2(65536, 2147483646).shr(31), ivec2(0, 0));
    assert_eq!(ivec2(2147483646, 2147483647).shl(31), ivec2(0, -2147483648));
    assert_eq!(ivec2(2147483646, 2147483647).shr(31), ivec2(0, 0));
    assert_eq!(ivec2(2147483647, -2147483648).shl(31), ivec2(-2147483648, 0));
    assert_eq!(ivec2(2147483647, -2147483648).shr(31), ivec2(0, -1));
}

#[test]
fn test_hash_serde() {
    let a = ivec2(1, 2);
    let b = ivec2(2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 2);
    let mut span = out.span();
    assert_eq!(Serde::<IVec2>::deserialize(ref span), Some(a));
}

