#[test]
fn test_neg() {
    assert_eq!(-ivec2(1, 2), ivec2(-1, -2));
    assert_eq!(-IVec2Trait::ZERO, IVec2Trait::ZERO);
    assert_eq!(-IVec2Trait::MAX, ivec2(-2147483647, -2147483647));
    assert_eq!(-IVec2Trait::ONE, IVec2Trait::NEG_ONE);
}

#[test]
fn test_is_negative() {
    assert_eq!(ivec2(1, 2).is_negative_bitmask(), 0);
    assert_eq!(ivec2(1, 2).is_negative_mask(), bvec2(false, false));
    assert_eq!(ivec2(-1, 2).is_negative_bitmask(), 1);
    assert_eq!(ivec2(-1, 2).is_negative_mask(), bvec2(true, false));
    assert_eq!(ivec2(1, -2).is_negative_bitmask(), 2);
    assert_eq!(ivec2(1, -2).is_negative_mask(), bvec2(false, true));
    assert_eq!(ivec2(-1, -2).is_negative_bitmask(), 3);
    assert_eq!(ivec2(-1, -2).is_negative_mask(), bvec2(true, true));
    assert_eq!(IVec2Trait::ZERO.is_negative_bitmask(), 0);
    assert_eq!(IVec2Trait::MIN.is_negative_bitmask(), 3);
    assert_eq!(IVec2Trait::MAX.is_negative_bitmask(), 0);
}

