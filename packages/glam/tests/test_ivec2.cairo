    assert_eq!(IVec2Trait::MIN.checked_sub_unsigned(UVec2Trait::ONE), None);
    assert_eq!(IVec2Trait::ZERO.checked_sub_unsigned(UVec2Trait::ONE), Some(IVec2Trait::NEG_ONE));
    assert_eq!(IVec2Trait::MAX.wrapping_add_unsigned(UVec2Trait::ONE), IVec2Trait::MIN);
