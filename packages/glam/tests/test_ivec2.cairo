#[test]
fn test_clamp() {
    assert_eq!(ivec2(0, 0).clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(1, 3));
    assert_eq!(ivec2(2, 2).clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(2, 3));
    assert_eq!(ivec2(4, 4).clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(4, 4));
    assert_eq!(ivec2(5, 5).clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(5, 5));
    assert_eq!(ivec2(6, 6).clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(6, 6));
    assert_eq!(ivec2(7, 7).clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(6, 7));
    assert_eq!(ivec2(9, 9).clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(6, 8));
    assert_eq!(IVec2Trait::MIN.clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(1, 3));
    assert_eq!(IVec2Trait::MAX.clamp(ivec2(1, 3), ivec2(6, 8)), ivec2(6, 8));
    assert_eq!(ivec2(1, 3).clamp(IVec2Trait::MIN, IVec2Trait::MAX), ivec2(1, 3));
}

#[test]
fn test_sum_product() {
    assert_eq!(ivec2(1, 2).element_sum(), 3);
    assert_eq!(ivec2(1, 2).element_product(), 2);
    assert_eq!(ivec2(3, -7).element_sum(), -4);
    assert_eq!(ivec2(3, -7).element_product(), -21);
    assert_eq!(ivec2(-1, -2).element_sum(), -3);
    assert_eq!(ivec2(-1, -2).element_product(), 2);
    assert_eq!(ivec2(0, 1).element_sum(), 1);
    assert_eq!(ivec2(0, 1).element_product(), 0);
    assert_eq!(ivec2(100, -200).element_sum(), -100);
    assert_eq!(ivec2(100, -200).element_product(), -20000);
}

#[test]
fn test_cmp() {
    let a = ivec2(1, 1);
    let b = ivec2(2, 2);
    assert!(a.cmplt(b).all());
    assert!(a.cmple(b).all());
    assert!(b.cmpgt(a).all());
    assert!(b.cmpge(a).all());
    assert!(a.cmpne(b).all());
    assert!(a.cmpeq(a).all());
    assert!(!a.cmpeq(b).any());
    assert!(a.cmple(a).all());
    assert!(a.cmpge(a).all());
    assert!(!a.cmplt(a).any());
    assert!(a == a);
    assert!(a != b);
    assert_eq!(
        ivec2(-2147483648, -2147483647).cmpeq(ivec2(-2147483647, -46341)), bvec2(false, false),
    );
    assert_eq!(
        ivec2(-2147483648, -2147483647).cmpne(ivec2(-2147483647, -46341)), bvec2(true, true),
    );
    assert_eq!(
        ivec2(-2147483648, -2147483647).cmpge(ivec2(-2147483647, -46341)), bvec2(false, false),
    );
    assert_eq!(
        ivec2(-2147483648, -2147483647).cmpgt(ivec2(-2147483647, -46341)), bvec2(false, false),
    );
    assert_eq!(
        ivec2(-2147483648, -2147483647).cmple(ivec2(-2147483647, -46341)), bvec2(true, true),
    );
    assert_eq!(
        ivec2(-2147483648, -2147483647).cmplt(ivec2(-2147483647, -46341)), bvec2(true, true),
    );
    assert_eq!(ivec2(-2147483648, -2147483647).cmpeq(ivec2(-46341, -1)), bvec2(false, false));
    assert_eq!(ivec2(-2147483648, -2147483647).cmpne(ivec2(-46341, -1)), bvec2(true, true));
    assert_eq!(ivec2(-2147483648, -2147483647).cmpge(ivec2(-46341, -1)), bvec2(false, false));
    assert_eq!(ivec2(-2147483648, -2147483647).cmpgt(ivec2(-46341, -1)), bvec2(false, false));
    assert_eq!(ivec2(-2147483648, -2147483647).cmple(ivec2(-46341, -1)), bvec2(true, true));
    assert_eq!(ivec2(-2147483648, -2147483647).cmplt(ivec2(-46341, -1)), bvec2(true, true));
    assert_eq!(ivec2(-2147483648, -2147483647).cmpeq(ivec2(-1, 1)), bvec2(false, false));
    assert_eq!(ivec2(-2147483648, -2147483647).cmpne(ivec2(-1, 1)), bvec2(true, true));
    assert_eq!(ivec2(-2147483648, -2147483647).cmpge(ivec2(-1, 1)), bvec2(false, false));
    assert_eq!(ivec2(-2147483648, -2147483647).cmpgt(ivec2(-1, 1)), bvec2(false, false));
    assert_eq!(ivec2(-2147483648, -2147483647).cmple(ivec2(-1, 1)), bvec2(true, true));
    assert_eq!(ivec2(-2147483648, -2147483647).cmplt(ivec2(-1, 1)), bvec2(true, true));
    assert_eq!(ivec2(-2147483647, -65536).cmpeq(ivec2(-65536, -7)), bvec2(false, false));
    assert_eq!(ivec2(-2147483647, -65536).cmpne(ivec2(-65536, -7)), bvec2(true, true));
    assert_eq!(ivec2(-2147483647, -65536).cmpge(ivec2(-65536, -7)), bvec2(false, false));
    assert_eq!(ivec2(-2147483647, -65536).cmpgt(ivec2(-65536, -7)), bvec2(false, false));
    assert_eq!(ivec2(-2147483647, -65536).cmple(ivec2(-65536, -7)), bvec2(true, true));
