#[test]
fn test_assign_ops() {
    let mut a = ivec2(20, 40);
    a += ivec2(2, 3);
    assert_eq!(a, ivec2(22, 43));
    let mut a = ivec2(20, 40);
    a += 3;
    assert_eq!(a, ivec2(23, 43));
    let mut a = ivec2(20, 40);
    a -= ivec2(2, 3);
    assert_eq!(a, ivec2(18, 37));
    let mut a = ivec2(20, 40);
    a -= 3;
    assert_eq!(a, ivec2(17, 37));
    let mut a = ivec2(20, 40);
    a *= ivec2(2, 3);
    assert_eq!(a, ivec2(40, 120));
    let mut a = ivec2(20, 40);
    a *= 3;
    assert_eq!(a, ivec2(60, 120));
    let mut a = ivec2(20, 40);
    a /= ivec2(2, 3);
    assert_eq!(a, ivec2(10, 13));
    let mut a = ivec2(20, 40);
    a /= 3;
    assert_eq!(a, ivec2(6, 13));
    let mut a = ivec2(20, 40);
    a %= ivec2(2, 3);
    assert_eq!(a, ivec2(0, 1));
    let mut a = ivec2(20, 40);
    a %= 3;
    assert_eq!(a, ivec2(2, 1));
}

