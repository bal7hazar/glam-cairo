#[test]
fn test_div_euclid_rem_euclid() {
    let one = IVec2Trait::ONE;
    let two = one + one;
    let three = two + one;
    let four = three + one;
    assert_eq!(three.div_euclid(two), one);
    assert_eq!((-three).div_euclid(two), -two);
    assert_eq!(three.div_euclid(-two), -one);
    assert_eq!((-three).div_euclid(-two), two);
    assert_eq!(four.rem_euclid(three), one);
    assert_eq!((-four).rem_euclid(three), two);
    assert_eq!(four.rem_euclid(-three), one);
    assert_eq!((-four).rem_euclid(-three), two);
    assert_eq!(
        ivec2(-2147483648, -2147483647).div_euclid(ivec2(-2147483647, -46341)), ivec2(2, 46341),
    );
