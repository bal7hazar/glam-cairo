#[test]
fn test_checked() {
    assert_eq!(IVec2Trait::MAX.checked_add(IVec2Trait::ONE), None);
    assert_eq!(IVec2Trait::MAX.checked_add(IVec2Trait::X), None);
    assert_eq!(IVec2Trait::MAX.checked_add(IVec2Trait::Y), None);
    assert_eq!(IVec2Trait::MAX.checked_add(IVec2Trait::ZERO), Some(IVec2Trait::MAX));
    assert_eq!(IVec2Trait::MIN.checked_sub(IVec2Trait::ONE), None);
    assert_eq!(IVec2Trait::MIN.checked_sub(IVec2Trait::X), None);
    assert_eq!(IVec2Trait::MIN.checked_sub(IVec2Trait::Y), None);
    assert_eq!(IVec2Trait::MIN.checked_sub(IVec2Trait::ZERO), Some(IVec2Trait::MIN));
    assert_eq!(IVec2Trait::MAX.checked_mul(IVec2Trait::MAX), None);
    assert_eq!(IVec2Trait::MAX.checked_mul(IVec2Trait::ZERO), Some(IVec2Trait::ZERO));
    assert_eq!(IVec2Trait::MAX.checked_mul(IVec2Trait::ONE), Some(IVec2Trait::MAX));
    assert_eq!(IVec2Trait::ZERO.checked_mul(IVec2Trait::ZERO), Some(IVec2Trait::ZERO));
    assert_eq!(IVec2Trait::ONE.checked_mul(IVec2Trait::ONE), Some(IVec2Trait::ONE));
    assert_eq!(IVec2Trait::MAX.checked_div(IVec2Trait::ZERO), None);
    assert_eq!(IVec2Trait::MAX.checked_div(IVec2Trait::X), None);
    assert_eq!(IVec2Trait::MAX.checked_div(IVec2Trait::Y), None);
    assert_eq!(IVec2Trait::ZERO.checked_div(IVec2Trait::ONE), Some(IVec2Trait::ZERO));
    assert_eq!(IVec2Trait::MAX.checked_div(IVec2Trait::ONE), Some(IVec2Trait::MAX));
    assert_eq!(IVec2Trait::MIN.checked_mul(IVec2Trait::MIN), None);
    assert_eq!(IVec2Trait::MAX.checked_mul(IVec2Trait::MIN), None);
    assert_eq!(IVec2Trait::MIN.checked_mul(IVec2Trait::MAX), None);
    assert_eq!(IVec2Trait::ZERO.checked_mul(IVec2Trait::MIN), Some(IVec2Trait::ZERO));
    assert_eq!(IVec2Trait::MIN.checked_mul(IVec2Trait::ONE), Some(IVec2Trait::MIN));
    assert_eq!(IVec2Trait::MIN.checked_div(IVec2Trait::ZERO), None);
    assert_eq!(IVec2Trait::MIN.checked_div(IVec2Trait::ONE), Some(IVec2Trait::MIN));
    assert_eq!(IVec2Trait::MIN.checked_div(IVec2Trait::NEG_ONE), None);
    assert_eq!(
        IVec2Trait::MAX.checked_div(IVec2Trait::NEG_ONE), Some(ivec2(-2147483647, -2147483647)),
    );
}

