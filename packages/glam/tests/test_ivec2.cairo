#[test]
fn test_wrapping_saturating() {
    assert_eq!(ivec2(2147483647, 5).wrapping_add(ivec2(1, 3)), ivec2(-2147483648, 8));
    assert_eq!(ivec2(-2147483648, 5).wrapping_sub(ivec2(1, 3)), ivec2(2147483647, 2));
    assert_eq!(ivec2(2147483647, 2).wrapping_mul(ivec2(3, 2)), ivec2(2147483645, 4));
    assert_eq!(ivec2(2147483647, 2).wrapping_div(ivec2(3, 2)), ivec2(715827882, 1));
    assert_eq!(
        ivec2(2147483647, -2147483648).saturating_add(ivec2(1, -1)), ivec2(2147483647, -2147483648),
    );
    assert_eq!(
        ivec2(-2147483648, 2147483647).saturating_sub(ivec2(1, -1)), ivec2(-2147483648, 2147483647),
    );
    assert_eq!(
        ivec2(2147483647, -2147483648).saturating_mul(ivec2(2, 2)), ivec2(2147483647, -2147483648),
    );
    assert_eq!(
        ivec2(2147483647, -2147483648).saturating_div(ivec2(2, 2)), ivec2(1073741823, -1073741824),
    );
    assert_eq!(IVec2Trait::MIN.wrapping_div(IVec2Trait::NEG_ONE), IVec2Trait::MIN);
    assert_eq!(IVec2Trait::MIN.saturating_div(IVec2Trait::NEG_ONE), IVec2Trait::MAX);
}

