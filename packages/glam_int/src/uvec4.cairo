/// `2^n`. Shifts are a multiplication / division by a power of two taken from a jump table
/// (a runtime `pow(2, n)` costs ~10 000 gas more, a `const` array lookup ~200 more).
#[inline(always)]
fn pow2(n: u32) -> u32 {
    match n {
        0 => 0x1,
        1 => 0x2,
        2 => 0x4,
        3 => 0x8,
        4 => 0x10,
        5 => 0x20,
        6 => 0x40,
        7 => 0x80,
        8 => 0x100,
        9 => 0x200,
        10 => 0x400,
        11 => 0x800,
        12 => 0x1000,
        13 => 0x2000,
        14 => 0x4000,
        15 => 0x8000,
        16 => 0x10000,
        17 => 0x20000,
        18 => 0x40000,
        19 => 0x80000,
        20 => 0x100000,
        21 => 0x200000,
        22 => 0x400000,
        23 => 0x800000,
        24 => 0x1000000,
        25 => 0x2000000,
        26 => 0x4000000,
        27 => 0x8000000,
        28 => 0x10000000,
        29 => 0x20000000,
        30 => 0x40000000,
        31 => 0x80000000,
        _ => core::panic_with_felt252('UVec4: shift overflow'),
    }
}

/// `(a << n) mod 2^32` with `p = 2^n`: widening multiplication, then the low 32 bits.
#[inline(always)]
fn shl_u32(a: u32, p: u32) -> u32 {
    let (_, lo) = DivRem::div_rem(a.wide_mul(p), 0x100000000);
    lo.try_into().unwrap()
}

/// Two's complement reinterpretation: `a - 2^32` when `a >= 2^31`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn u32_as_i32(a: u32) -> i32 {
    match a.try_into() {
        Some(v) => v,
        None => {
            let f: felt252 = a.into();
            (f - 0x100000000).try_into().unwrap()
        },
    }
}

/// `|a - b|` (never overflows): `checked_sub` is the comparison and the subtraction at once.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn abs_diff_u32(a: u32, b: u32) -> u32 {
    match a.checked_sub(b) {
        Some(d) => d,
        None => b - a,
    }
}

/// `wide_mul` (1 step) and a downcast: cheaper than the corelib `CheckedMul`.
#[inline(always)]
fn checked_mul_u32(a: u32, b: u32) -> Option<u32> {
    a.wide_mul(b).try_into()
}

/// `wide_mul` (1 step) and a downcast: cheaper than the corelib `SaturatingMul`.
#[inline(always)]
fn saturating_mul_u32(a: u32, b: u32) -> u32 {
    a.wide_mul(b).try_into().unwrap_or(0xffffffff)
}

#[allow(manual_unwrap_or)]
#[inline(always)]
fn checked_div_u32(a: u32, b: u32) -> Option<u32> {
    match TryInto::<u32, NonZero<u32>>::try_into(b) {
        Some(d) => {
            let (q, _) = DivRem::div_rem(a, d);
            Some(q)
        },
        None => None,
    }
}

#[inline(always)]
fn checked_add_signed(a: u32, b: i32) -> Option<u32> {
    let s: felt252 = a.into() + b.into();
    s.try_into()
}

/// `-2^31 <= a + b < 2^32 + 2^31`: at most one wrap, in the direction of the sign of `b`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn wrapping_add_signed(a: u32, b: i32) -> u32 {
    let s: felt252 = a.into() + b.into();
    match s.try_into() {
        Some(v) => v,
        None => if b < 0 {
            (s + 0x100000000).try_into().unwrap()
        } else {
            (s - 0x100000000).try_into().unwrap()
        },
    }
}

#[allow(manual_unwrap_or)]
#[inline(always)]
fn saturating_add_signed(a: u32, b: i32) -> u32 {
    let s: felt252 = a.into() + b.into();
    match s.try_into() {
        Some(v) => v,
        None => if b < 0 {
            0
        } else {
            0xffffffff
        },
    }
}
