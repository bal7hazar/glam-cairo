#!/usr/bin/env bash
# Runs scripts/prepush.sh for each commit being pushed. Enabled by `git config core.hooksPath .githooks`.
# Never bypass it (no --no-verify): fix what it reports.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
shas=()
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ -n "${local_sha:-}" && "$local_sha" != "$zero" ]] && shas+=("$local_sha")
done

for sha in "${shas[@]}"; do
  scripts/prepush.sh "$sha" </dev/null
done
